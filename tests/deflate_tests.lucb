## The deflate regression driver tests/run.py builds in every compiler mode: it
## inflates a packed file and checks it against the raw one.
from luce_std import files
import memory
import c
from luce_raster.binary import Buffer
from luce_compress import compress

pub func main(arguments: str[]) -> i32!:
    let raw_file = try files.read((c.str)arguments[1])
    defer raw_file.release()
    let raw = raw_file.value
    let packed_file = try files.read((c.str)arguments[2])
    defer packed_file.release()
    let packed = packed_file.value
    let out = try new u8[raw.length]
    defer free(out)
    try compress.inflate(packed, out)
    assert((str)out == (str)raw)
    var encoded = Buffer()
    defer encoded.close()
    let zipped = try compress.compress(raw)
    defer free(zipped) in memory.heap
    try encoded.put(zipped)
    try compress.inflate(encoded.view(), out)
    assert((str)out == (str)raw)
    try files.write((c.str)arguments[3], encoded.view())
    return 0
