## A warp stroke's changed cells made ready for the GPU: premultiplied RGBA
## f32 samples to the straight-alpha half floats tiles hold, a cell per task
## across the processors. Only the uploads themselves stay on the main thread,
## so a big smudge tip's many cells cost a frame little.
import math
import os
import thread
from half import to_half

## One cell to convert: its samples (256 rows of 256, premultiplied), where
## its bytes go (256 rows of 256, 8 a pixel), the part on the document, and
## whether any of it has alpha, found while converting.
pub struct PackCell:
    pub var pixels: const f32[]
    pub var bytes: u8[]
    pub var width: usize
    pub var height: usize
    pub var painted: bool

## Convert every cell of `cells`, spread over the processors.
pub func pack_cells(cells: PackCell[]) -> !:
    let workers = (usize)math.imin(16, math.imax(1, (i64)os.cpus()))
    if workers <= 1 or cells.length < 2:
        for index in 0..<cells.length:
            pack_cell(&cells[index])
        return
    var shares: PackShare[16] = ---
    var handles: thread.Handle[16]
    var started: usize = 0
    let count = workers if workers < cells.length else cells.length
    let per = (cells.length + count - 1) // count
    for share in 0..<count:
        let first = share * per if share * per < cells.length else cells.length
        let last = first + per if first + per < cells.length else cells.length
        shares[share] = PackShare(cells = cells, first = first, last = last)
    for share in 1..<count:
        handles[started] = thread.spawn(pack_entry, (void*)&shares[share], name = "warp-pack") catch failure:
            for other in share..<count:
                pack_share(&shares[other])
            break
        started += 1
    pack_share(&shares[0])
    for index in 0..<started:
        try handles[index].join()

## One worker's cells `first..<last`.
struct PackShare:
    var cells: PackCell[]
    var first: usize
    var last: usize

func pack_entry(context: void*?):
    pack_share((PackShare*)(context else return))

func pack_share(share: PackShare*):
    for index in share.first..<share.last:
        pack_cell(&share.cells[index])

## A cell's samples as straight-alpha halves; clear past the document's edge.
func pack_cell(cell: PackCell*):
    let side: usize = 256
    var painted = false
    for y in 0..<side:
        for x in 0..<side:
            let destination = (y * side + x) * 8
            if x >= cell.width or y >= cell.height:
                for byte in 0..<(usize)8:
                    cell.bytes[destination + byte] = 0
                continue
            let source = (y * side + x) * 4
            let alpha = cell.pixels[source + 3]
            if alpha > 0.0:
                painted = true
            for channel in 0..<(usize)4:
                var value = cell.pixels[source + channel]
                if channel < 3:
                    value = value / alpha if alpha > 0.0 else 0.0
                let half = to_half(value)
                cell.bytes[destination + channel * 2] = (u8)(half & 0xff)
                cell.bytes[destination + channel * 2 + 1] = (u8)(half >> 8)
    cell.painted = painted
