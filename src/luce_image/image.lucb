## Public, owning Pillow-style image API. Codec code is entirely Luce Base.
import c as c_api
import files
import interop
import memory
import math
import strings
import os
import thread
import raster as model
import png
import jpeg
import tiff
import exr
import raw
import heic
import luce_image.parallel as parallel
from luce_image.svg_import import is_svg, render_svg
from binary import Buffer
from raster_errors import invalid, unsupported

pub type SampleType = model.SampleType

pub struct Pixel:
    pub let r: f64 = 0.0
    pub let g: f64 = 0.0
    pub let b: f64 = 0.0
    pub let a: f64 = 255.0

func check_path(path: str) -> !:
    if path.length == 0 or strings.contains(path, "\0"):
        error(invalid, "path is empty or contains a NUL byte")

func probe(raster: model.Raster*) -> !:
    if raster.encoded.length < 4:
        error(invalid, "image signature is truncated")
    let data = raster.encoded
    if data[0] == 137:
        if raster.frame != 0:
            error(invalid, "PNG has one frame")
        try png.probe(raster)
    elif data[0] == 255 and data[1] == 216:
        if raster.frame != 0:
            error(invalid, "JPEG has one frame")
        try jpeg.probe(raster)
    elif data[0] == 118 and data[1] == 47:
        try exr.probe(raster)
    elif heic.is_heic(data):
        try heic.probe(raster)
    elif raw.detect(data) or raw.recognize(data):
        # Camera raws before TIFF: most of them are TIFF files underneath (CR3 is
        # ISO media, RAF and CRW their own). One luce-raw knows but cannot develop
        # yet says so, rather than being read as a TIFF.
        try raw.probe(raster)
    elif (data[0] == 'I' and data[1] == 'I') or (data[0] == 'M' and data[1] == 'M'):
        try tiff.probe(raster)
    else:
        error(unsupported, "unrecognized image signature")

## Whether a probed file is a camera raw luce-raw develops.
func is_raw_format(name: str) -> bool:
    for format_name in ["DNG", "CR2", "CR3", "NEF", "ARW", "ORF", "RW2", "PEF", "RAF"]:
        if name == format_name:
            return true
    return false

func configure_mode(raster: model.Raster*, mode: str) -> !:
    let nc: usize = 3 if mode == "RGB" or mode == "RGBF" else 4 if mode == "RGBA" or mode == "RGBAF" else 2 if mode == "LA" else 1
    if mode != "L" and mode != "LA" and mode != "RGB" and mode != "RGBA" and mode != "I;16" and mode != "I" and mode != "F" and mode != "RGBF" and mode != "RGBAF":
        error(invalid, "unsupported image mode")
    let kind = SampleType.uint16 if mode == "I;16" else SampleType.uint32 if mode == "I" else SampleType.float32 if mode == "F" or mode == "RGBF" or mode == "RGBAF" else SampleType.uint8
    try raster.standard(nc, kind)

pub struct Image:
    var raster: model.Raster
    var threads: usize = 4
    var active_workers: usize
    var closed: bool

    func init():
        self.raster = model.Raster()
        self.threads = 4
        self.active_workers = 0
        self.closed = false

    static func own(raster: model.Raster, threads: usize = 4) -> interop.Reference[Image]!:
        var reservation = try interop.Reservation[Image](image_type)
        errdefer reservation.cancel()
        let native = try new Image() in memory.heap
        native.raster = raster
        native.threads = threads
        return reservation.publish(native, memory.heap)

    func ensure_open() -> !:
        if self.closed:
            error(invalid, "image is closed")

    ## Snapshot the encoded file now; decode pixels lazily on load/access/save.
    pub static func open(path: str, threads: usize = 4, frame: usize = 0, max_bytes: usize = 4294967296, max_pixels: usize = 268435456) -> interop.Reference[Image]!:
        try check_path(path)
        if threads < 1 or threads > 64:
            error(invalid, "thread count must be in 1-64")
        if is_svg(path):
            # Drawn rather than decoded: vector artwork at a size fit to edit.
            let rendered = try render_svg(path, max_bytes, max_pixels)
            defer free(rendered.pixels) in memory.heap
            return try Image.from_linear_rgba(rendered.width, rendered.height, rendered.pixels)
        var raster = model.Raster(max_bytes = max_bytes, max_pixels = max_pixels, frame = frame)
        errdefer raster.close()
        with memory.heap:
            raster.path = try strings.copy(path)
            raster.encoded = try files.read_limit((c_api.str)raster.path, max_bytes)
        try probe(&raster)
        return try Image.own(raster, threads)

    ## As `open`, from encoded bytes held in memory; the bytes are copied.
    pub static func open_bytes(data: const u8[], threads: usize = 4, frame: usize = 0, max_bytes: usize = 4294967296, max_pixels: usize = 268435456) -> interop.Reference[Image]!:
        if threads < 1 or threads > 64 or data.length > max_bytes:
            error(invalid, "invalid threads or encoded byte limit")
        var raster = model.Raster(max_bytes = max_bytes, max_pixels = max_pixels, frame = frame)
        errdefer raster.close()
        raster.encoded = try alloc u8[data.length] in memory.heap
        memory.copy(raster.encoded, data, data.length)
        try probe(&raster)
        return try Image.own(raster, threads)

    ## A new image in a Pillow mode ("L", "LA", "RGB", "RGBA", "I;16", "I", "F",
    ## "RGBF", "RGBAF"), every pixel `color` or opaque black.
    pub static func create(mode: str, width: usize, height: usize, color: Pixel? = none, max_bytes: usize = 4294967296) -> interop.Reference[Image]!:
        var raster = model.Raster(width = width, height = height, max_bytes = max_bytes)
        errdefer raster.close()
        try configure_mode(&raster, mode)
        try raster.allocate()
        let pixel = color else Pixel(a = model.maximum(raster.channels[0].kind))
        for i in 0..<width * height:
            for c in 0..<raster.channels.length:
                let name = raster.channels[c].name
                raster.pixels[i * raster.channels.length + c] = pixel.a if name == "A" else pixel.g if name == "G" else pixel.b if name == "B" else pixel.r
        return try Image.own(raster)

    ## Named channels are used for AOVs and Cryptomatte; default storage is FLOAT.
    pub static func create_channels(width: usize, height: usize, names: const str[], kind: SampleType = .float32, max_bytes: usize = 4294967296) -> interop.Reference[Image]!:
        var raster = model.Raster(width = width, height = height, max_bytes = max_bytes)
        errdefer raster.close()
        for name in names:
            try raster.channel(name, kind)
        try raster.allocate()
        return try Image.own(raster)

    pub func width() -> usize!:
        try self.ensure_open()
        return self.raster.width

    pub func height() -> usize!:
        try self.ensure_open()
        return self.raster.height

    ## (width, height).
    pub func size() -> (usize, usize)!:
        try self.ensure_open()
        return (self.raster.width, self.raster.height)

    ## The data window's top-left: EXR's offset, zero for other formats.
    pub func origin() -> (i64, i64)!:
        try self.ensure_open()
        return (self.raster.xmin, self.raster.ymin)

    ## The format the image was read from: "PNG", "JPEG", "TIFF" or "EXR"; empty when created.
    pub func file_format() -> str!:
        try self.ensure_open()
        return self.raster.file_format

    ## How many frames (TIFF pages, EXR parts) the file holds.
    pub func n_frames() -> usize!:
        try self.ensure_open()
        return self.raster.frames

    ## The frame now selected; `seek` changes it.
    pub func tell() -> usize!:
        try self.ensure_open()
        return self.raster.frame

    pub func channel_count() -> usize!:
        try self.ensure_open()
        return self.raster.channels.length

    pub func channel_name(index: usize) -> str!:
        try self.ensure_open()
        if index >= self.raster.channels.length:
            error(invalid, "channel index out of range")
        return self.raster.channels[index].name

    pub func channel_type(index: usize) -> SampleType!:
        try self.ensure_open()
        if index >= self.raster.channels.length:
            error(invalid, "channel index out of range")
        return self.raster.channels[index].kind

    ## The index of the channel named `name`; an error when there is none.
    pub func channel_index(name: str) -> usize!:
        try self.ensure_open()
        return try self.raster.find_channel(name)

    ## The Pillow mode the channels make, or "MULTI" when they fit none (named
    ## AOV channels, mixed sample types).
    pub func mode() -> str!:
        try self.ensure_open()
        let channels = self.raster.channels
        let kind = channels[0].kind
        for channel in channels:
            if channel.kind != kind:
                return "MULTI"
        if channels.length == 1:
            return "L" if kind == .uint8 else "I;16" if kind == .uint16 else "I" if kind == .uint32 else "F"
        if channels.length == 2 and channels[0].name == "Y" and kind == .uint8:
            return "LA"
        if channels.length == 3 and channels[0].name == "R" and channels[1].name == "G" and channels[2].name == "B":
            return "RGB" if kind == .uint8 else "RGBF" if kind == .float32 else "MULTI"
        if channels.length == 4 and channels[0].name == "R" and channels[3].name == "A":
            return "RGBA" if kind == .uint8 else "RGBAF" if kind == .float32 else "MULTI"
        return "MULTI"

    ## Whether the pixels are decoded; most reads decode them on first use.
    pub func is_loaded() -> bool:
        return not self.closed and self.raster.pixels.length > 0

    ## How many threads the last decode used.
    pub func workers_used() -> usize:
        return self.active_workers

    ## Decode the pixels now, in parallel for TIFF, EXR, HEIC and camera raws.
    pub mutating func load() -> !:
        try self.ensure_open()
        if self.is_loaded():
            return
        try self.raster.allocate()
        errdefer self.discard_pixels()
        if self.raster.file_format == "PNG":
            try png.decode(&self.raster)
            self.active_workers = 1
        elif self.raster.file_format == "JPEG":
            try jpeg.decode(&self.raster)
            self.active_workers = 1
        elif self.raster.file_format == "HEIC":
            try heic.decode(&self.raster, self.threads)
            self.active_workers = self.threads
        elif is_raw_format(self.raster.file_format):
            # A raw develops whole, on its own threads.
            try raw.decode(&self.raster, raw.Options(threads = self.threads))
            self.active_workers = self.threads
        elif self.raster.file_format == "TIFF":
            self.active_workers = try parallel.decode(&self.raster, tiff.decode_chunk, self.threads)
        else:
            self.active_workers = try parallel.decode(&self.raster, exr.decode_chunk, self.threads)

    mutating func discard_pixels():
        if self.raster.pixels.length > 0:
            free(self.raster.pixels) in memory.heap
        var empty: f64[]
        self.raster.pixels = empty
        self.active_workers = 0

    ## Select frame `frame` of the file, as Pillow's seek; the pixels decode again on use.
    pub mutating func seek(frame: usize) -> !:
        try self.ensure_open()
        if frame == self.raster.frame:
            return
        let selected = try Image.open_bytes(self.raster.encoded, self.threads, frame, self.raster.max_bytes, self.raster.max_pixels)
        defer selected.release()
        let other = selected.value()
        if self.raster.path.length > 0:
            with memory.heap:
                other.raster.path = try strings.copy(self.raster.path)
        self.raster.close()
        self.raster = other.raster
        other.raster = model.Raster()
        self.active_workers = 0

    func offset(x: usize, y: usize, channel: usize) -> usize!:
        if x >= self.raster.width or y >= self.raster.height or channel >= self.raster.channels.length:
            error(invalid, "pixel or channel index out of range")
        return (y * self.raster.width + x) * self.raster.channels.length + channel

    ## One raw sample of one channel, in the channel's own range.
    pub mutating func get_sample(x: usize, y: usize, channel: usize = 0) -> f64!:
        try self.load()
        return self.raster.pixels[try self.offset(x, y, channel)]

    ## Set one raw sample of one channel.
    pub mutating func put_sample(x: usize, y: usize, channel: usize, value: f64) -> !:
        try self.load()
        self.raster.pixels[try self.offset(x, y, channel)] = value

    ## The color at a pixel from its Y or R, G, B and A channels, in the samples'
    ## own range; alpha is the maximum when there is no A channel.
    pub mutating func getpixel(x: usize, y: usize) -> Pixel!:
        try self.load()
        discard(try self.offset(x, y, 0))
        var r: f64 = 0.0
        var g: f64 = 0.0
        var b: f64 = 0.0
        var a = model.maximum(self.raster.channels[0].kind)
        for c in 0..<self.raster.channels.length:
            let name = self.raster.channels[c].name
            let value = self.raster.pixels[(y * self.raster.width + x) * self.raster.channels.length + c]
            if name == "Y":
                r = value
                g = value
                b = value
            elif name == "R":
                r = value
            elif name == "G":
                g = value
            elif name == "B":
                b = value
            elif name == "A":
                a = value
        return Pixel(r, g, b, a)

    ## Set a pixel's color channels; named non-color channels take `put_sample`.
    pub mutating func putpixel(x: usize, y: usize, pixel: Pixel) -> !:
        try self.load()
        discard(try self.offset(x, y, 0))
        for c in 0..<self.raster.channels.length:
            let name = self.raster.channels[c].name
            if name != "Y" and name != "R" and name != "G" and name != "B" and name != "A":
                error(invalid, "use put_sample for named non-color channels")
        for c in 0..<self.raster.channels.length:
            let name = self.raster.channels[c].name
            self.raster.pixels[(y * self.raster.width + x) * self.raster.channels.length + c] = pixel.a if name == "A" else pixel.g if name == "G" else pixel.b if name == "B" else pixel.r

    pub func metadata_count() -> usize!:
        try self.ensure_open()
        return self.raster.attributes.length

    pub func metadata_key(index: usize) -> str!:
        try self.ensure_open()
        if index >= self.raster.attributes.length:
            error(invalid, "metadata index out of range")
        return self.raster.attributes[index].name

    ## A string attribute's value, or empty when there is none; typed ones take `metadata_bytes`.
    pub func metadata(name: str) -> str!:
        try self.ensure_open()
        for entry in self.raster.attributes:
            if entry.name == name:
                if entry.type_name != "string":
                    error(invalid, "typed metadata must be read with metadata_bytes")
                return (str)entry.data
        return ""

    ## An attribute's type name as the file stores it ("string", EXR's "v2f"…), or empty.
    pub func metadata_type(name: str) -> str!:
        try self.ensure_open()
        for entry in self.raster.attributes:
            if entry.name == name:
                return entry.type_name
        return ""

    ## An attribute's raw bytes, whatever its type, or empty.
    pub func metadata_bytes(name: str) -> const u8[]!:
        try self.ensure_open()
        for entry in self.raster.attributes:
            if entry.name == name:
                return entry.data
        return b""

    ## Move the data window's top-left, as EXR stores it.
    pub mutating func set_origin(x: i64, y: i64) -> !:
        try self.ensure_open()
        if x < -2147483648 or y < -2147483648 or x > 2147483647 - (i64)self.raster.width + 1 or y > 2147483647 - (i64)self.raster.height + 1:
            error(invalid, "image data window exceeds int32")
        self.raster.xmin = x
        self.raster.ymin = y

    ## The path the image was opened from, or empty.
    pub func source_path() -> str!:
        try self.ensure_open()
        return self.raster.path

    pub mutating func set_metadata(name: str, value: str) -> !:
        try self.ensure_open()
        if strings.contains(name, "\0"):
            error(invalid, "metadata name contains NUL")
        try self.raster.attribute(name, "string", value.bytes)

    ## Encode and write atomically to `path`: the format from `file_format` or the
    ## extension; `compression` and `tile` for TIFF and EXR, `quality` (1..100) for
    ## JPEG, `bigtiff` for TIFF.
    pub mutating func save(path: str, file_format: str = "", compression: str = "zip", quality: i64 = 90, tile: usize = 0, bigtiff: bool = false) -> !:
        try check_path(path)
        # Managed Luce text is a byte view, not necessarily NUL-terminated.
        let destination = try strings.copy(path)
        defer strings.release(destination)
        var selected = file_format
        if selected.length == 0:
            let dot = strings.find_last(path, ".") else error(invalid, "output format is required without a filename extension")
            selected = (str)path.bytes[dot + 1..]
        let encoded = try self.encode(selected, compression, quality, tile, bigtiff)
        defer free(encoded) in memory.heap
        try files.write_atomic((c_api.str)destination, encoded)

    ## The image encoded as `file_format` ("png", "jpg"/"jpeg", "tif"/"tiff" or
    ## "exr"), with the options `save` takes: heap bytes the caller frees.
    pub mutating func encode(file_format: str, compression: str = "zip", quality: i64 = 90, tile: usize = 0, bigtiff: bool = false) -> u8[]!:
        try self.load()
        let lower = try strings.to_lower(file_format)
        defer strings.release(lower)
        var encoded = Buffer(maximum = self.raster.max_bytes)
        defer encoded.close()
        if lower == "png":
            if tile != 0 or bigtiff:
                error(invalid, "tile and BigTIFF options do not apply to PNG")
            try png.encode(&self.raster, &encoded)
        elif lower == "jpg" or lower == "jpeg":
            if tile != 0 or bigtiff:
                error(invalid, "tile and BigTIFF options do not apply to JPEG")
            try jpeg.encode(&self.raster, &encoded, quality)
        elif lower == "tif" or lower == "tiff":
            try tiff.encode(&self.raster, &encoded, compression, tile, bigtiff)
        elif lower == "exr":
            if bigtiff:
                error(invalid, "BigTIFF option does not apply to EXR")
            try exr.encode(&self.raster, &encoded, compression, tile)
        else:
            error(unsupported, "unsupported output image format")
        let view = encoded.view()
        let bytes = try alloc u8[view.length] in memory.heap
        memory.copy(bytes, view, view.length)
        return bytes

    ## An "RGBA" image's pixels as 8-bit samples, top-down, four per pixel: heap
    ## bytes the caller frees.
    pub mutating func rgba8() -> u8[]!:
        try self.load()
        if (try self.mode()) != "RGBA":
            error(invalid, "only an RGBA image has 8-bit RGBA samples")
        let bytes = try alloc u8[self.raster.pixels.length] in memory.heap
        for index in 0..<bytes.length:
            bytes[index] = (u8)self.raster.pixels[index]
        return bytes

    ## Every pixel as straight-alpha linear-light RGBA f32 samples, top-down,
    ## four per pixel: integer modes are taken as sRGB-encoded, float modes as
    ## linear already. For the editor's tiles; Base only.
    pub mutating func linear_rgba(pixels: f32[]) -> !:
        try self.load()
        if pixels.length != self.raster.width * self.raster.height * 4:
            error(invalid, "pixel buffer must hold width * height RGBA samples")
        let kind = self.raster.channels[0].kind
        # Which sample is which, worked out once as `getpixel` reads them.
        var job = LinearJob(source = self.raster.pixels, pixels = pixels, stride = self.raster.channels.length, width = self.raster.width,
                            red = -1, green = -1, blue = -1, alpha = -1, scale = 1.0 / model.maximum(kind), encoded = kind != .float16 and kind != .float32 and kind != .float64,
                            table = none, first = 0, last = self.raster.height)
        for c in 0..<self.raster.channels.length:
            let name = self.raster.channels[c].name
            if name == "Y":
                job.red = (i64)c
                job.green = (i64)c
                job.blue = (i64)c
            elif name == "R":
                job.red = (i64)c
            elif name == "G":
                job.green = (i64)c
            elif name == "B":
                job.blue = (i64)c
            elif name == "A":
                job.alpha = (i64)c
        # 8 and 16-bit samples decode through a table rather than a pow each.
        if kind != .uint8 and kind != .uint16:
            try linear_bands(&job)
            return
        let table = try alloc f32[256 if kind == .uint8 else 65536] in memory.heap
        defer free(table) in memory.heap
        for value in 0..<table.length:
            table[value] = (f32)decode_srgb((f64)value * job.scale)
        job.table = table
        try linear_bands(&job)

    ## An 8-bit RGBA image from straight-alpha linear-light RGBA f32 samples,
    ## sRGB-encoded and clamped. Base only.
    pub static func from_linear_rgba(width: usize, height: usize, pixels: const f32[]) -> interop.Reference[Image]!:
        if pixels.length != width * height * 4:
            error(invalid, "pixel data must hold width * height RGBA samples")
        let image = try Image.create("RGBA", width, height)
        errdefer image.release()
        let target = image.value()
        for index in 0..<width * height:
            target.raster.pixels[index * 4] = encode_srgb((f64)pixels[index * 4])
            target.raster.pixels[index * 4 + 1] = encode_srgb((f64)pixels[index * 4 + 1])
            target.raster.pixels[index * 4 + 2] = encode_srgb((f64)pixels[index * 4 + 2])
            target.raster.pixels[index * 4 + 3] = math.floor(math.clamp((f64)pixels[index * 4 + 3], 0.0, 1.0) * 255.0 + 0.5)
        return image

    ## An 8-bit RGBA image from `width * height * 4` sRGB-encoded bytes. Base only.
    pub static func from_rgba8(width: usize, height: usize, bytes: const u8[]) -> interop.Reference[Image]!:
        if bytes.length != width * height * 4:
            error(invalid, "pixel data must hold width * height RGBA bytes")
        let image = try Image.create("RGBA", width, height)
        errdefer image.release()
        let target = image.value()
        for index in 0..<bytes.length:
            target.raster.pixels[index] = (f64)bytes[index]
        return image

    ## A new image with the same channels, pixels and attributes.
    pub mutating func copy() -> interop.Reference[Image]!:
        return try self.crop(0, 0, try self.width(), try self.height())

    ## The pixels from (`left`, `top`) up to but not including (`right`, `bottom`).
    pub mutating func crop(left: usize, top: usize, right: usize, bottom: usize) -> interop.Reference[Image]!:
        try self.load()
        if left >= right or top >= bottom or right > self.raster.width or bottom > self.raster.height:
            error(invalid, "crop rectangle is empty or outside the image")
        var raster = model.Raster(width = right - left, height = bottom - top, xmin = self.raster.xmin + (i64)left, ymin = self.raster.ymin + (i64)top, max_bytes = self.raster.max_bytes)
        errdefer raster.close()
        for channel in self.raster.channels:
            try raster.channel(channel.name, channel.kind)
        for attr in self.raster.attributes:
            try raster.attribute(attr.name, attr.type_name, attr.data)
        try raster.allocate()
        let nc = raster.channels.length
        for y in 0..<raster.height:
            for x in 0..<raster.width:
                for c in 0..<nc:
                    raster.pixels[(y * raster.width + x) * nc + c] = self.raster.pixels[((top + y) * self.raster.width + left + x) * nc + c]
        return try Image.own(raster, self.threads)

    ## Channel `name` alone, as a one-channel "Y" image.
    pub mutating func get_channel(name: str) -> interop.Reference[Image]!:
        try self.load()
        let channel = try self.raster.find_channel(name)
        var raster = model.Raster(width = self.raster.width, height = self.raster.height, xmin = self.raster.xmin, ymin = self.raster.ymin, max_bytes = self.raster.max_bytes)
        errdefer raster.close()
        try raster.channel("Y", self.raster.channels[channel].kind)
        try raster.allocate()
        for i in 0..<raster.pixels.length:
            raster.pixels[i] = self.raster.pixels[i * self.raster.channels.length + channel]
        return try Image.own(raster, self.threads)

    ## The image in another Pillow mode; grey comes from Rec. 601 luma.
    pub mutating func convert(mode: str) -> interop.Reference[Image]!:
        try self.load()
        let out = try Image.create(mode, self.raster.width, self.raster.height, max_bytes = self.raster.max_bytes)
        errdefer out.release()
        let target = out.value()
        let source_max = model.maximum(self.raster.channels[0].kind)
        let target_max = model.maximum(target.raster.channels[0].kind)
        let integer = (i64)target.raster.channels[0].kind <= 3
        # Which source sample feeds each color, worked out once as `getpixel` reads them.
        var red: i64 = -1
        var green: i64 = -1
        var blue: i64 = -1
        var alpha: i64 = -1
        for c in 0..<self.raster.channels.length:
            let name = self.raster.channels[c].name
            if name == "Y":
                red = (i64)c
                green = (i64)c
                blue = (i64)c
            elif name == "R":
                red = (i64)c
            elif name == "G":
                green = (i64)c
            elif name == "B":
                blue = (i64)c
            elif name == "A":
                alpha = (i64)c
        # And what each target channel is: 0 red, 1 green, 2 blue, 3 alpha, 4 luma.
        var wanted: u8[16]
        let channels = target.raster.channels.length
        for c in 0..<channels:
            let name = target.raster.channels[c].name
            wanted[c] = 3 if name == "A" else 1 if name == "G" else 2 if name == "B" else 4 if name == "Y" else 0
        let source_stride = self.raster.channels.length
        let scale = target_max / source_max
        for index in 0..<self.raster.width * self.raster.height:
            let at = index * source_stride
            let r = self.raster.pixels[at + (usize)red] if red >= 0 else 0.0
            let g = self.raster.pixels[at + (usize)green] if green >= 0 else 0.0
            let b = self.raster.pixels[at + (usize)blue] if blue >= 0 else 0.0
            let a = self.raster.pixels[at + (usize)alpha] if alpha >= 0 else source_max
            for c in 0..<channels:
                let kind = wanted[c]
                let source = r if kind == 0 else g if kind == 1 else b if kind == 2 else a if kind == 3 else 0.299 * r + 0.587 * g + 0.114 * b
                let value = source * scale
                target.raster.pixels[index * channels + c] = math.floor(math.clamp(value, 0.0, target_max) + 0.5) if integer else value
        return out

    ## Nearest is appropriate for discrete IDs. Bilinear must never filter IDs.
    pub mutating func resize(width: usize, height: usize, resample: str = "nearest") -> interop.Reference[Image]!:
        try self.load()
        if resample != "nearest" and resample != "bilinear":
            error(invalid, "resample must be nearest or bilinear")
        var raster = model.Raster(width = width, height = height, max_bytes = self.raster.max_bytes)
        errdefer raster.close()
        for channel in self.raster.channels:
            try raster.channel(channel.name, channel.kind)
        try raster.allocate()
        let nc = raster.channels.length
        for y in 0..<height:
            for x in 0..<width:
                let sx = math.clamp(((f64)x + 0.5) * (f64)self.raster.width / (f64)width - 0.5, 0.0, (f64)(self.raster.width - 1))
                let sy = math.clamp(((f64)y + 0.5) * (f64)self.raster.height / (f64)height - 0.5, 0.0, (f64)(self.raster.height - 1))
                for c in 0..<nc:
                    var value: f64 = 0.0
                    if resample == "nearest":
                        value = self.raster.pixels[((usize)math.floor(sy + 0.5) * self.raster.width + (usize)math.floor(sx + 0.5)) * nc + c]
                    else:
                        let x0 = (usize)math.floor(sx)
                        let y0 = (usize)math.floor(sy)
                        let x1 = x0 + 1 if x0 + 1 < self.raster.width else x0
                        let y1 = y0 + 1 if y0 + 1 < self.raster.height else y0
                        let fx = sx - (f64)x0
                        let fy = sy - (f64)y0
                        let top = self.raster.pixels[(y0 * self.raster.width + x0) * nc + c] * (1.0 - fx) + self.raster.pixels[(y0 * self.raster.width + x1) * nc + c] * fx
                        let bottom = self.raster.pixels[(y1 * self.raster.width + x0) * nc + c] * (1.0 - fx) + self.raster.pixels[(y1 * self.raster.width + x1) * nc + c] * fx
                        value = top * (1.0 - fy) + bottom * fy
                        if (i64)raster.channels[c].kind <= 3:
                            value = math.floor(value + 0.5)
                    raster.pixels[(y * width + x) * nc + c] = value
        return try Image.own(raster, self.threads)

    pub mutating func close():
        if self.closed:
            return
        self.raster.close()
        self.closed = true

pub let image_type: interop.Type[Image] = interop.Type[Image]("Image", Image.close, closeable = true)

## The linear value of an sRGB-encoded component in 0..1.
func decode_srgb(value: f64) -> f64:
    let clamped = math.clamp(value, 0.0, 1.0)
    return clamped / 12.92 if clamped <= 0.04045 else math.pow((clamped + 0.055) / 1.055, 2.4)

## Rows `first..<last` of an image for `linear_rgba`.
struct LinearJob:
    var source: const f64[]
    var pixels: f32[]
    var stride: usize
    var width: usize
    ## Each color's sample within a pixel; -1 when absent.
    var red: i64
    var green: i64
    var blue: i64
    var alpha: i64
    var scale: f64
    var encoded: bool
    var table: const f32[]?
    var first: usize
    var last: usize

func linear_entry(context: void*?):
    linear_rows((LinearJob*)(context else return))

func linear_rows(job: LinearJob*):
    for index in job.first * job.width..<job.last * job.width:
        let at = index * job.stride
        job.pixels[index * 4] = linear_sample(job, at, job.red)
        job.pixels[index * 4 + 1] = linear_sample(job, at, job.green)
        job.pixels[index * 4 + 2] = linear_sample(job, at, job.blue)
        job.pixels[index * 4 + 3] = (f32)(job.source[at + (usize)job.alpha] * job.scale) if job.alpha >= 0 else 1.0

func linear_sample(job: const LinearJob*, at: usize, channel: i64) -> f32:
    if channel < 0:
        return 0.0
    let value = job.source[at + (usize)channel]
    if let table = job.table:
        return table[(usize)math.clamp(value, 0.0, (f64)(table.length - 1))]
    return (f32)(decode_srgb(value * job.scale) if job.encoded else value * job.scale)

func min_rows(a: usize, b: usize) -> usize:
    return a if a < b else b

## `job`'s rows in bands over the processors.
func linear_bands(job: LinearJob*) -> !:
    let rows = job.last
    let workers = math.imin(16, math.imax(1, (i64)os.cpus())) if rows * job.width >= 262144 else 1
    if workers <= 1:
        linear_rows(job)
        return
    var bands: LinearJob[16]
    var handles: thread.Handle[16]
    var started: usize = 0
    let per = (rows + (usize)workers - 1) // (usize)workers
    for band in 0..<(usize)workers:
        bands[band] = *job
        bands[band].first = min_rows(rows, band * per)
        bands[band].last = min_rows(rows, band * per + per)
    for band in 1..<(usize)workers:
        handles[started] = thread.spawn(linear_entry, (void*)&bands[band], name = "linear-rgba") catch failure:
            for other in band..<(usize)workers:
                linear_rows(&bands[other])
            break
        started += 1
    linear_rows(&bands[0])
    for index in 0..<started:
        try handles[index].join()

## The 8-bit sRGB encoding of a linear component.
func encode_srgb(value: f64) -> f64:
    let clamped = math.clamp(value, 0.0, 1.0)
    let encoded = clamped * 12.92 if clamped <= 0.0031308 else 1.055 * math.pow(clamped, 1.0 / 2.4) - 0.055
    return math.floor(encoded * 255.0 + 0.5)
