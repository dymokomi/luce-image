## Smudge and Liquify's push, as Compositor's (Document/SmudgeLiquify.swift):
## both work dab by dab on a premultiplied working copy of the layer on the
## CPU, and the tiles a dab reaches are uploaded as the stroke goes, so the
## canvas shows it live. The working copy is kept a cell at a time, each read
## back from the layer as it was when the stroke began the first time a dab
## comes near it: a stroke costs the cells it passes, not the document. The tip falls off as a smoothstep from the hardness
## to the rim.
## - Smudge picks up the pixels under the first dab and carries them: each
##   dab lays them down by the tip, and keeps `strength` of what it carried
##   (1 carries forever, less picks up more of what it passes).
## - Push moves the pixels under the tip along the stroke by `strength` of
##   each step, sampled back from behind the brush (bilinear).
import math
import memory
import os
import thread
from tiles import Tiles, tile_size
from raster_errors import invalid

pub let warp_smudge: i64 = 0
pub let warp_push: i64 = 1

## One cell of the working copy: 256 rows of 256 premultiplied RGBA f32 samples.
struct WarpCell:
    var pixels: f32[]

pub struct WarpStroke:
    var width: usize
    var height: usize
    var columns: usize
    ## The layer as the stroke began (sharing its tiles), where cells are read from.
    var source: Tiles
    ## The working copy's cells, each none until a dab first comes near it.
    var cells: WarpCell*?[]
    var mode: i64
    var radius: f64
    var hardness: f64
    var strength: f64
    ## Smudge's carried square, (2r+1)² RGBA; push's scratch copy of a dab's area.
    var carried: f32[]
    var scratch: f32[]
    var last_x: f64
    var last_y: f64
    var debt: f64
    ## The tip's weight at each offset of a dab's square, side by side: a
    ## smudge's dabs land on whole pixels, so every one shares it.
    var weights: f32[]
    ## The cells changed since the last upload.
    var dirty_left: i64
    var dirty_top: i64
    var dirty_right: i64
    var dirty_bottom: i64

    ## Begin on `tiles` (straight alpha) at (`x`, `y`): `diameter`, `hardness`
    ## (at most 0.98) and `strength` (0.01..1).
    pub static func begin(tiles: const Tiles*, mode: i64, x: f64, y: f64, diameter: f64, hardness: f64, strength: f64) -> WarpStroke!:
        if mode != warp_smudge and mode != warp_push:
            error(invalid, "a warp stroke smudges or pushes")
        if not math.is_finite(x) or not math.is_finite(y) or not (diameter >= 1.0 and diameter <= 5000.0):
            error(invalid, "a warp stroke needs a finite point and a diameter of 1..5000")
        let width = (usize)tiles.width()
        let height = (usize)tiles.height()
        var source = try tiles.clone()
        errdefer source.destroy()
        let count = (usize)tiles.columns() * (usize)tiles.rows()
        let cells = try alloc WarpCell*?[count] in memory.heap
        errdefer free(cells) in memory.heap
        for index in 0..<count:
            cells[index] = none
        let radius = math.max(1.0, diameter * 0.5)
        let side = (usize)(math.ceil(radius) * 2.0 + 1.0)
        let carried = try alloc f32[side * side * 4] in memory.heap
        errdefer free(carried) in memory.heap
        let weights = try alloc f32[side * side] in memory.heap
        errdefer free(weights) in memory.heap
        var no_scratch: f32[]
        var stroke = WarpStroke(width = width, height = height, columns = (usize)tiles.columns(), source = source, cells = cells, mode = mode, radius = radius,
                                hardness = math.clamp(hardness, 0.0, 0.98), strength = math.clamp(strength, 0.01, 1.0),
                                carried = carried, scratch = no_scratch, weights = weights, last_x = x, last_y = y, debt = 0.0,
                                dirty_left = 1, dirty_top = 1, dirty_right = 0, dirty_bottom = 0)
        let reach = (i64)math.ceil(radius)
        for j in 0..<(i64)side:
            for i in 0..<(i64)side:
                weights[(usize)j * side + (usize)i] = (f32)stroke.weight(math.hypot((f64)(i - reach), (f64)(j - reach)))
        if mode == warp_smudge:
            try stroke.pick_up(x, y)
        return stroke

    ## Continue to (`x`, `y`), a dab every spacing along the way.
    pub mutating func extend(x: f64, y: f64) -> !:
        if not math.is_finite(x) or not math.is_finite(y):
            error(invalid, "stroke coordinates must be finite")
        let dx = x - self.last_x
        let dy = y - self.last_y
        let length = math.sqrt(dx * dx + dy * dy)
        let step = math.max(1.0, self.radius * 2.0 * (0.08 if self.mode == warp_smudge else 0.025))
        var along = step - self.debt
        var from_x = self.last_x
        var from_y = self.last_y
        while along <= length:
            let t = along / length
            let to_x = self.last_x + dx * t
            let to_y = self.last_y + dy * t
            if self.mode == warp_smudge:
                try self.smudge(to_x, to_y)
            else:
                try self.push(from_x, from_y, to_x, to_y)
            from_x = to_x
            from_y = to_y
            along += step
        self.debt = length - (along - step)
        self.last_x = x
        self.last_y = y

    ## Whether any cell changed since the last upload.
    pub func dirty() -> bool:
        return self.dirty_right >= self.dirty_left

    ## Upload the cells changed since the last upload into `tiles`.
    pub mutating func flush(tiles: Tiles*) -> !:
        if self.dirty_right < self.dirty_left:
            return
        var row = self.dirty_top
        while row <= self.dirty_bottom:
            var column = self.dirty_left
            while column <= self.dirty_right:
                # A cell no dab came near is as it was.
                if let cell = self.cells[(usize)row * self.columns + (usize)column]:
                    try tiles.write_cell_premultiplied((u32)column, (u32)row, cell.pixels)
                column += 1
            row += 1
        self.dirty_left = 1
        self.dirty_right = 0

    pub mutating func destroy():
        for index in 0..<self.cells.length:
            if let cell = self.cells[index]:
                free(cell.pixels) in memory.heap
                free(cell) in memory.heap
        free(self.cells) in memory.heap
        self.source.destroy()
        free(self.carried) in memory.heap
        free(self.weights) in memory.heap
        if self.scratch.length > 0:
            free(self.scratch) in memory.heap

    # -- The dabs.

    ## How much of a dab reaches `distance` from its middle: whole within the
    ## hardness, a smoothstep down to nothing at the rim.
    func weight(distance: f64) -> f64:
        let u = distance / self.radius
        if u >= 1.0:
            return 0.0
        if u <= self.hardness:
            return 1.0
        let t = (1.0 - u) / (1.0 - self.hardness)
        return t * t * (3.0 - 2.0 * t)

    ## Smudge: the square under the first dab, carried.
    mutating func pick_up(x: f64, y: f64) -> !:
        let reach = (i64)math.ceil(self.radius)
        let side = reach * 2 + 1
        let cx = (i64)math.round(x)
        let cy = (i64)math.round(y)
        try self.load(cx - reach, cy - reach, cx + reach, cy + reach)
        for j in 0..<side:
            for i in 0..<side:
                let at = ((usize)j * (usize)side + (usize)i) * 4
                for channel in 0..<(usize)4:
                    self.carried[at + channel] = self.pixel(cx - reach + i, cy - reach + j, channel)

    mutating func smudge(x: f64, y: f64) -> !:
        let reach = (i64)math.ceil(self.radius)
        let side = reach * 2 + 1
        let cx = (i64)math.round(x)
        let cy = (i64)math.round(y)
        try self.load(cx - reach, cy - reach, cx + reach, cy + reach)
        # Each row of the square is its own pixels and its own carried samples:
        # the rows go to the processors.
        var job = SmudgeJob(stroke = &self, cx = cx, cy = cy, reach = reach, first = 0, last = side)
        try smudge_bands(&job)
        self.touch(cx - reach, cy - reach, cx + reach, cy + reach)

    ## Push: each pixel under the tip takes what was behind it along the
    ## step, by the tip's weight there.
    mutating func push(from_x: f64, from_y: f64, to_x: f64, to_y: f64) -> !:
        let move_x = (to_x - from_x) * self.strength
        let move_y = (to_y - from_y) * self.strength
        let reach = (i64)math.ceil(self.radius)
        let margin = reach + (i64)math.ceil(math.abs(move_x) + math.abs(move_y)) + 2
        let cx = (i64)math.round(to_x)
        let cy = (i64)math.round(to_y)
        # The area as it was before this dab, so the dab reads nothing it wrote.
        let left = cx - margin
        let top = cy - margin
        let side = (usize)(margin * 2 + 1)
        try self.load(left, top, cx + margin, cy + margin)
        if self.scratch.length < side * side * 4:
            if self.scratch.length > 0:
                free(self.scratch) in memory.heap
            self.scratch = try alloc f32[side * side * 4] in memory.heap
        for j in 0..<side:
            for i in 0..<side:
                for channel in 0..<(usize)4:
                    self.scratch[(j * side + i) * 4 + channel] = self.pixel(left + (i64)i, top + (i64)j, channel)
        for j in -reach..<(reach + 1):
            for i in -reach..<(reach + 1):
                let px = cx + i
                let py = cy + j
                if px < 0 or py < 0 or px >= (i64)self.width or py >= (i64)self.height:
                    continue
                let w = self.weight(math.hypot((f64)px - to_x, (f64)py - to_y))
                if w <= 0.0:
                    continue
                let sx = (f64)(px - left) - move_x * w
                let sy = (f64)(py - top) - move_y * w
                let pixels = self.cell_pixels(px, py)
                let at = offset_in_cell(px, py)
                for channel in 0..<(usize)4:
                    pixels[at + channel] = (f32)bilinear(self.scratch, side, sx, sy, channel)
        self.touch(cx - reach, cy - reach, cx + reach, cy + reach)

    ## A sample of the working copy (its cell loaded); transparent past its edges.
    func pixel(x: i64, y: i64, channel: usize) -> f32:
        if x < 0 or y < 0 or x >= (i64)self.width or y >= (i64)self.height:
            return 0.0
        return self.cell_pixels(x, y)[offset_in_cell(x, y) + channel]

    ## The loaded cell holding document pixel (`x`, `y`), on the document.
    func cell_pixels(x: i64, y: i64) -> f32[]:
        let index = (usize)(y // (i64)tile_size) * self.columns + (usize)(x // (i64)tile_size)
        let cell = self.cells[index] else trap("a warp dab reached a cell it did not load")
        return cell.pixels

    ## Read in, premultiplied, every cell over document pixels `left`..`right`,
    ## `top`..`bottom` that is not yet in the working copy.
    mutating func load(left: i64, top: i64, right: i64, bottom: i64) -> !:
        let rows = (i64)self.cells.length // (i64)self.columns
        let first_column = math.imax(0, left // (i64)tile_size)
        let first_row = math.imax(0, top // (i64)tile_size)
        let last_column = math.imin((i64)self.columns - 1, right // (i64)tile_size)
        let last_row = math.imin(rows - 1, bottom // (i64)tile_size)
        var row = first_row
        while row <= last_row:
            var column = first_column
            while column <= last_column:
                let index = (usize)row * self.columns + (usize)column
                if self.cells[index] == none:
                    let pixels = try alloc f32[(usize)tile_size * (usize)tile_size * 4] in memory.heap
                    errdefer free(pixels) in memory.heap
                    try self.source.read_cell((u32)column, (u32)row, pixels)
                    for at in 0..<pixels.length // 4:
                        let alpha = pixels[at * 4 + 3]
                        for channel in 0..<(usize)3:
                            pixels[at * 4 + channel] *= alpha
                    self.cells[index] = try new WarpCell(pixels = pixels) in memory.heap
                column += 1
            row += 1

    ## Mark the cells a dab over document pixels `left`..`right`, `top`..`bottom` reached.
    mutating func touch(left: i64, top: i64, right: i64, bottom: i64):
        let columns = ((i64)self.width + (i64)tile_size - 1) // (i64)tile_size
        let rows = ((i64)self.height + (i64)tile_size - 1) // (i64)tile_size
        let first_column = math.imax(0, left // (i64)tile_size)
        let first_row = math.imax(0, top // (i64)tile_size)
        let last_column = math.imin(columns - 1, right // (i64)tile_size)
        let last_row = math.imin(rows - 1, bottom // (i64)tile_size)
        if last_column < first_column or last_row < first_row:
            return
        if self.dirty_right < self.dirty_left:
            self.dirty_left = first_column
            self.dirty_top = first_row
            self.dirty_right = last_column
            self.dirty_bottom = last_row
            return
        self.dirty_left = math.imin(self.dirty_left, first_column)
        self.dirty_top = math.imin(self.dirty_top, first_row)
        self.dirty_right = math.imax(self.dirty_right, last_column)
        self.dirty_bottom = math.imax(self.dirty_bottom, last_row)

## A bilinear sample of a `side`-wide square of RGBA samples; transparent past it.
func bilinear(samples: const f32[], side: usize, x: f64, y: f64, channel: usize) -> f64:
    let x0 = math.floor(x)
    let y0 = math.floor(y)
    let fx = x - x0
    let fy = y - y0
    let a = texel(samples, side, (i64)x0, (i64)y0, channel)
    let b = texel(samples, side, (i64)x0 + 1, (i64)y0, channel)
    let c = texel(samples, side, (i64)x0, (i64)y0 + 1, channel)
    let d = texel(samples, side, (i64)x0 + 1, (i64)y0 + 1, channel)
    return (a + (b - a) * fx) + ((c + (d - c) * fx) - (a + (b - a) * fx)) * fy

func texel(samples: const f32[], side: usize, x: i64, y: i64, channel: usize) -> f64:
    if x < 0 or y < 0 or x >= (i64)side or y >= (i64)side:
        return 0.0
    return (f64)samples[((usize)y * side + (usize)x) * 4 + channel]

## Where document pixel (`x`, `y`)'s samples start within its cell.
func offset_in_cell(x: i64, y: i64) -> usize:
    return ((usize)(y % (i64)tile_size) * (usize)tile_size + (usize)(x % (i64)tile_size)) * 4

## One worker's rows `first..<last` of a smudge dab's square around (`cx`, `cy`).
struct SmudgeJob:
    var stroke: WarpStroke*
    var cx: i64
    var cy: i64
    var reach: i64
    var first: i64
    var last: i64

func smudge_entry(context: void*?):
    smudge_rows((SmudgeJob*)(context else return))

## Lay the carried pixels down by the tip's weight, and carry `strength` of
## what was laid, row by row.
func smudge_rows(job: SmudgeJob*):
    let stroke = job.stroke
    let side = job.reach * 2 + 1
    let strength = (f32)stroke.strength
    for j in job.first..<job.last:
        let py = job.cy - job.reach + j
        if py < 0 or py >= (i64)stroke.height:
            continue
        for i in 0..<side:
            let px = job.cx - job.reach + i
            if px < 0 or px >= (i64)stroke.width:
                continue
            let w = stroke.weights[(usize)(j * side + i)]
            let k = (usize)(j * side + i) * 4
            let pixels = stroke.cell_pixels(px, py)
            let at = offset_in_cell(px, py)
            for channel in 0..<(usize)4:
                let under = pixels[at + channel]
                let carried = stroke.carried[k + channel]
                let painted = under + (carried - under) * w
                pixels[at + channel] = painted
                stroke.carried[k + channel] = painted + (carried - painted) * strength

## `job`'s rows split across the processors; small dabs stay on this thread.
func smudge_bands(job: SmudgeJob*) -> !:
    let rows = job.last - job.first
    let workers = math.imin(16, math.imax(1, (i64)os.cpus())) if rows * rows >= 65536 else 1
    if workers <= 1:
        smudge_rows(job)
        return
    var shares: SmudgeJob[16] = ---
    var handles: thread.Handle[16]
    var started: usize = 0
    let per = (rows + workers - 1) // workers
    for share in 0..<workers:
        shares[(usize)share] = *job
        shares[(usize)share].first = math.imin(job.last, job.first + share * per)
        shares[(usize)share].last = math.imin(job.last, job.first + share * per + per)
    for share in 1..<workers:
        handles[started] = thread.spawn(smudge_entry, (void*)&shares[(usize)share], name = "smudge") catch failure:
            for other in share..<workers:
                smudge_rows(&shares[(usize)other])
            break
        started += 1
    smudge_rows(&shares[0])
    for index in 0..<started:
        try handles[index].join()
