## The brush engine's dynamics, sampled tips and textures, painted on the GPU
## and read back: what a pen sample, a tip image or a texture does to the dabs.
import gpu
import memory
import math
from luce_image.document import Document
from luce_image.brush import Brush, Painter, Stroke
from luce_image.brush_images import BrushImages, texture_image
from luce_image.dynamics import Dynamic, Control, Pen, dynamic_size, dynamic_angle, dynamic_flow

## A 128 × 128 document with one layer, its painter, and pixels to read into.
struct Bench:
    var device: gpu.Device
    var document: Document
    var painter: Painter
    var layer: u64
    var pixels: f32[]

    static func open() -> Bench?!:
        var device = gpu.Device.open() catch failure:
            assert(failure.code == gpu.unavailable)
            return none
        errdefer device.destroy()
        var document = try Document.create(device, 128, 128)
        errdefer document.destroy()
        let layer = try document.add_layer("Paint")
        var painter = try Painter.create(device)
        errdefer painter.destroy()
        let pixels = try alloc f32[(usize)128 * 128 * 4] in memory.heap
        return Bench(device = device, document = document, painter = painter, layer = layer, pixels = pixels)

    ## One dab of `brush` at (`x`, `y`) with `pen`, through `images`, then the pixels.
    mutating func dab(brush: Brush, x: f64, y: f64, pen: Pen = Pen(), images: BrushImages*? = none) -> !:
        var stroke = try Stroke.begin(&self.painter, &self.document, self.layer, brush, x, y, pen = pen, images = images)
        stroke.finish()
        try self.read()

    mutating func read() -> !:
        let tiles = (self.document.find(self.layer) else trap("layer")).tiles() else trap("tiles")
        try tiles.read(self.pixels)

    ## The alpha at (`x`, `y`).
    func alpha(x: usize, y: usize) -> f32:
        return self.pixels[(y * 128 + x) * 4 + 3]

    ## How many pixels are painted over half.
    func painted() -> usize:
        var count: usize = 0
        for index in 0..<(usize)128 * 128:
            if self.pixels[index * 4 + 3] > 0.5:
                count += 1
        return count

    mutating func close():
        free(self.pixels) in memory.heap
        self.painter.destroy()
        self.document.destroy()
        self.device.destroy()

test "pen pressure through the size dynamic shrinks the dab from its minimum up":
    var bench = (try Bench.open()) else return
    defer bench.close()
    var brush = Brush(diameter = 40.0, hardness = 1.0, color = gpu.Color(0.0, 0.0, 0.0, 1.0))
    brush.dynamics[dynamic_size] = Dynamic(control = Control.pressure, minimum = 0.0)
    try bench.dab(brush, 64.0, 64.0, pen = Pen(pressure = 0.5))
    # A 20 pixel dab: 19 pixels right of centre is outside, 8 inside.
    assert(bench.alpha(72, 64) > 0.99 and bench.alpha(83, 64) == 0.0)
    let half = bench.painted()
    assert(half > 250 and half < 380)

test "a mouse's pressure paints the full size, and off leaves the size alone":
    var bench = (try Bench.open()) else return
    defer bench.close()
    var brush = Brush(diameter = 40.0, hardness = 1.0)
    brush.dynamics[dynamic_size] = Dynamic(control = Control.pressure, minimum = 0.0)
    try bench.dab(brush, 64.0, 64.0, pen = Pen(pressure = 0.0))
    assert(bench.alpha(82, 64) > 0.99)

test "the angle follows the pen's azimuth":
    var bench = (try Bench.open()) else return
    defer bench.close()
    # A flat ellipse, long along its angle: turned by the azimuth to stand upright.
    var brush = Brush(diameter = 60.0, hardness = 1.0, roundness = 0.2)
    brush.dynamics[dynamic_angle] = Dynamic(control = Control.azimuth)
    try bench.dab(brush, 64.0, 64.0, pen = Pen(azimuth = 90.0, altitude = 45.0))
    assert(bench.alpha(64, 90) > 0.99 and bench.alpha(64, 38) > 0.99)
    assert(bench.alpha(90, 64) == 0.0 and bench.alpha(38, 64) == 0.0)

test "flow follows the airbrush wheel":
    var bench = (try Bench.open()) else return
    defer bench.close()
    var brush = Brush(diameter = 30.0, hardness = 1.0)
    brush.dynamics[dynamic_flow] = Dynamic(control = Control.wheel)
    try bench.dab(brush, 64.0, 64.0, pen = Pen(tangential = 0.25))
    let alpha = bench.alpha(64, 64)
    assert(alpha > 0.2 and alpha < 0.3)

test "a sampled tip paints its image, turned and fitted to the dab":
    var bench = (try Bench.open()) else return
    defer bench.close()
    var images = BrushImages()
    defer images.destroy()
    # The tip's left half paints, its right half does not.
    let tip = try alloc u8[(usize)64 * 64] in memory.heap
    defer free(tip) in memory.heap
    for y in 0..<64:
        for x in 0..<64:
            tip[y * 64 + x] = 255 if x < 32 else 0
    try images.set_tip(tip, 64, 64)
    let brush = Brush(diameter = 60.0, hardness = 1.0)
    try bench.dab(brush, 64.0, 64.0, images = &images)
    assert(bench.alpha(50, 64) > 0.99 and bench.alpha(78, 64) == 0.0)
    # The image is square: its corners paint too, unlike a round tip.
    assert(bench.alpha(37, 37) > 0.99)
    # Turned a quarter clockwise, the painted half is on top.
    var turned = brush
    turned.angle = 90.0
    var second = (try Bench.open()) else return
    defer second.close()
    # Textures belong to one device: the second bench's brush images are its own.
    var own = BrushImages()
    defer own.destroy()
    try own.set_tip(tip, 64, 64)
    try second.dab(turned, 64.0, 64.0, images = &own)
    assert(second.alpha(64, 50) > 0.99 and second.alpha(64, 78) == 0.0)

test "a texture image multiplies into each dab by its depth, tiled in document space":
    var bench = (try Bench.open()) else return
    defer bench.close()
    var images = BrushImages()
    defer images.destroy()
    # Stripes four pixels wide: painting, then not.
    let stripes = try alloc u8[(usize)8 * 8] in memory.heap
    defer free(stripes) in memory.heap
    for y in 0..<8:
        for x in 0..<8:
            stripes[y * 8 + x] = 255 if x < 4 else 0
    try images.set_pattern(stripes, 8, 8)
    let brush = Brush(diameter = 80.0, hardness = 1.0, texture = texture_image, texture_depth = 1.0)
    try bench.dab(brush, 64.0, 64.0, images = &images)
    # Pixels 65 and 66 fall in a painting stripe (64..68), 69 and 70 in a bare one.
    assert(bench.alpha(65, 64) > 0.99 and bench.alpha(70, 64) < 0.01)
    # The same stripes repeat 8 pixels on.
    assert(bench.alpha(73, 64) > 0.99 and bench.alpha(78, 64) < 0.01)
    # Half the depth leaves half in the bare stripes.
    var second = (try Bench.open()) else return
    defer second.close()
    var shallow = brush
    shallow.texture_depth = 0.5
    var own = BrushImages()
    defer own.destroy()
    try own.set_pattern(stripes, 8, 8)
    try second.dab(shallow, 64.0, 64.0, images = &own)
    assert(second.alpha(70, 64) > 0.45 and second.alpha(70, 64) < 0.55 and second.alpha(65, 64) > 0.99)

test "a stroke's pressure eases from one point to the next":
    var bench = (try Bench.open()) else return
    defer bench.close()
    var brush = Brush(diameter = 30.0, hardness = 1.0, spacing = 0.1)
    brush.dynamics[dynamic_size] = Dynamic(control = Control.pressure, minimum = 0.0)
    var stroke = try Stroke.begin(&bench.painter, &bench.document, bench.layer, brush, 20.0, 64.0, pen = Pen(pressure = 0.2))
    try stroke.extend(&bench.painter, &bench.document, 108.0, 64.0, pen = Pen(pressure = 1.0))
    try stroke.flush(&bench.painter, &bench.document)
    stroke.finish()
    try bench.read()
    # Thin at the start, thick at the end.
    var start_rows = 0
    var end_rows = 0
    for y in 0..<128:
        if bench.alpha(30, (usize)y) > 0.5:
            start_rows += 1
        if bench.alpha(100, (usize)y) > 0.5:
            end_rows += 1
    assert(start_rows > 0 and end_rows > start_rows * 2)
