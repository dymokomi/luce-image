import files
import memory
import c
from binary import Buffer
import compress

pub func main(arguments: str[]) -> i32!:
    let raw = try files.read((c.str)arguments[1])
    defer free(raw)
    let packed = try files.read((c.str)arguments[2])
    defer free(packed)
    let out = try new u8[raw.length]
    defer free(out)
    try compress.inflate(packed, out)
    assert((str)out == (str)raw)
    var encoded = Buffer()
    defer encoded.close()
    let zipped = try compress.compress(raw)
    defer free(zipped) in memory.heap
    try encoded.put(zipped)
    try compress.inflate(encoded.view(), out)
    assert((str)out == (str)raw)
    try files.write((c.str)arguments[3], encoded.view())
    return 0
