pub let segment_frag_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float2 origin;\n    float2 a;\n    float2 b;\n    float radius;\n    float hardness;\n    float flow;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstruct luce_fragment_in\n{\n    float4 vertex_color [[user(locn0)]];\n};\n\nfragment luce_fragment_out luce_fragment(luce_fragment_in in [[stage_in]], constant Params& params [[buffer(0)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 p = gl_FragCoord.xy - params.origin;\n    float2 ab = params.b - params.a;\n    float t = dot(p - params.a, ab) / fast::max(dot(ab, ab), 9.9999999747524270787835121154785e-07);\n    float2 q = params.a + (ab * fast::clamp(t, 0.0, 1.0));\n    float d = distance(p, q);\n    float core = params.radius * params.hardness;\n    float c = 1.0 - smoothstep(core, fast::max(params.radius, core + 0.5), d);\n    float a = (c * params.flow) * in.vertex_color.w;\n    out.fragment_color = float4(a);\n    return out;\n}\n\n"

