pub let blur_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float radius;\n    float sigma;\n    float horizontal;\n    float extent;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstatic inline __attribute__((always_inline))\nfloat4 fetch(thread const float2& texel, constant Params& params, texture2d<float> before, sampler beforeSmplr, texture2d<float> after, sampler afterSmplr, texture2d<float> middle, sampler middleSmplr)\n{\n    float _27;\n    if (params.horizontal > 0.5)\n    {\n        _27 = texel.x;\n    }\n    else\n    {\n        _27 = texel.y;\n    }\n    float along = _27;\n    float2 uv;\n    if (along < 0.0)\n    {\n        float2 _48;\n        if (params.horizontal > 0.5)\n        {\n            _48 = float2(texel.x + 256.0, texel.y);\n        }\n        else\n        {\n            _48 = float2(texel.x, texel.y + 256.0);\n        }\n        uv = _48;\n        return before.sample(beforeSmplr, (uv / float2(256.0)));\n    }\n    if (along >= params.extent)\n    {\n        float2 _86;\n        if (params.horizontal > 0.5)\n        {\n            _86 = float2(texel.x - params.extent, texel.y);\n        }\n        else\n        {\n            _86 = float2(texel.x, texel.y - params.extent);\n        }\n        uv = _86;\n        return after.sample(afterSmplr, (uv / float2(256.0)));\n    }\n    return middle.sample(middleSmplr, (texel / float2(256.0)));\n}\n\nfragment luce_fragment_out luce_fragment(constant Params& params [[buffer(0)]], texture2d<float> before [[texture(1)]], texture2d<float> middle [[texture(2)]], texture2d<float> after [[texture(3)]], sampler beforeSmplr [[sampler(1)]], sampler middleSmplr [[sampler(2)]], sampler afterSmplr [[sampler(3)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 p = gl_FragCoord.xy;\n    int taps = int(params.radius);\n    float4 sum = float4(0.0);\n    float weights = 0.0;\n    int _139 = -taps;\n    float2 _167;\n    for (int i = _139; i <= taps; i++)\n    {\n        float w = exp(((-0.5) * float(i * i)) / (params.sigma * params.sigma));\n        if (params.horizontal > 0.5)\n        {\n            _167 = float2(p.x + float(i), p.y);\n        }\n        else\n        {\n            _167 = float2(p.x, p.y + float(i));\n        }\n        float2 q = _167;\n        float2 param = q;\n        float4 c = fetch(param, params, before, beforeSmplr, after, afterSmplr, middle, middleSmplr);\n        sum += (float4(c.xyz * c.w, c.w) * w);\n        weights += w;\n    }\n    sum /= float4(fast::max(weights, 9.9999999747524270787835121154785e-07));\n    float3 _226;\n    if (sum.w > 0.0)\n    {\n        _226 = sum.xyz / float3(sum.w);\n    }\n    else\n    {\n        _226 = float3(0.0);\n    }\n    out.fragment_color = float4(_226, sum.w);\n    return out;\n}\n\n"

