pub let dab_frag_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float2 origin;\n    float2 center;\n    float2 tile;\n    float2 direction;\n    float radius;\n    float hardness;\n    float flow;\n    float roundness;\n    float red;\n    float green;\n    float blue;\n    float unused0;\n    float unused1;\n    float unused2;\n    float unused3;\n    float unused4;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstruct luce_fragment_in\n{\n    float4 vertex_color [[user(locn0)]];\n};\n\nfragment luce_fragment_out luce_fragment(luce_fragment_in in [[stage_in]], constant Params& params [[buffer(0)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 p = (gl_FragCoord.xy - params.origin) - params.center;\n    float2 q = float2(dot(p, params.direction), dot(p, float2(-params.direction.y, params.direction.x)));\n    q.y /= fast::max(params.roundness, 0.0500000007450580596923828125);\n    float d = length(q);\n    float core = params.radius * params.hardness;\n    float c = 1.0 - smoothstep(core, fast::max(params.radius, core + 0.5), d);\n    float a = (c * params.flow) * in.vertex_color.w;\n    out.fragment_color = float4(float3(params.red, params.green, params.blue) * a, a);\n    return out;\n}\n\n"

