pub let paint_frag_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float4 color;\n    float opacity;\n    float erase;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nfragment luce_fragment_out luce_fragment(constant Params& params [[buffer(0)]], texture2d<float> original [[texture(1)]], texture2d<float> coverage [[texture(2)]], sampler originalSmplr [[sampler(1)]], sampler coverageSmplr [[sampler(2)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 uv = gl_FragCoord.xy / float2(256.0);\n    float4 o = original.sample(originalSmplr, uv);\n    float s = fast::min(coverage.sample(coverageSmplr, uv).x, 1.0) * params.opacity;\n    if (params.erase > 0.5)\n    {\n        out.fragment_color = float4(o.xyz, o.w * (1.0 - s));\n        return out;\n    }\n    float a = s + (o.w * (1.0 - s));\n    float3 _84;\n    if (a > 0.0)\n    {\n        _84 = ((params.color.xyz * s) + ((o.xyz * o.w) * (1.0 - s))) / float3(a);\n    }\n    else\n    {\n        _84 = o.xyz;\n    }\n    float3 rgb = _84;\n    out.fragment_color = float4(rgb, a);\n    return out;\n}\n\n"
