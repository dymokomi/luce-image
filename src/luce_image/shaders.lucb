pub let lift_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float2 tile;\n    float2 offset;\n    float2 extent;\n    float copy;\n    float unused;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstatic inline __attribute__((always_inline))\nbool inside(thread const float2& p, constant Params& params)\n{\n    bool _20 = p.x >= 0.0;\n    bool _27;\n    if (_20)\n    {\n        _27 = p.y >= 0.0;\n    }\n    else\n    {\n        _27 = _20;\n    }\n    bool _41;\n    if (_27)\n    {\n        _41 = p.x < params.extent.x;\n    }\n    else\n    {\n        _41 = _27;\n    }\n    bool _49;\n    if (_41)\n    {\n        _49 = p.y < params.extent.y;\n    }\n    else\n    {\n        _49 = _41;\n    }\n    return _49;\n}\n\nfragment luce_fragment_out luce_fragment(constant Params& params [[buffer(0)]], texture2d<float> layer [[texture(1)]], texture2d<float> selection [[texture(2)]], sampler layerSmplr [[sampler(1)]], sampler selectionSmplr [[sampler(2)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 p = floor(gl_FragCoord.xy) + params.tile;\n    float4 base = float4(0.0);\n    float2 param = p;\n    if (inside(param, params))\n    {\n        base = layer.read(uint2(int2(p)), 0);\n        if (params.copy < 0.5)\n        {\n            base.w *= (1.0 - selection.read(uint2(int2(p)), 0).x);\n        }\n    }\n    float2 q = p - params.offset;\n    float4 moved = float4(0.0);\n    float2 param_1 = q;\n    if (inside(param_1, params))\n    {\n        moved = layer.read(uint2(int2(q)), 0);\n        moved.w *= selection.read(uint2(int2(q)), 0).x;\n    }\n    float a = moved.w + (base.w * (1.0 - moved.w));\n    float3 _145;\n    if (a > 0.0)\n    {\n        _145 = ((moved.xyz * moved.w) + ((base.xyz * base.w) * (1.0 - moved.w))) / float3(a);\n    }\n    else\n    {\n        _145 = float3(0.0);\n    }\n    float3 rgb = _145;\n    out.fragment_color = float4(rgb, a);\n    return out;\n}\n\n"

