pub let gradient_frag_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float4 from_color;\n    float4 to_color;\n    float2 origin;\n    float2 a;\n    float2 b;\n    float selected;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nfragment luce_fragment_out luce_fragment(constant Params& params [[buffer(0)]], texture2d<float> original [[texture(1)]], texture2d<float> selection [[texture(2)]], sampler originalSmplr [[sampler(1)]], sampler selectionSmplr [[sampler(2)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 uv = gl_FragCoord.xy / float2(256.0);\n    float4 o = original.sample(originalSmplr, uv);\n    float2 p = params.origin + gl_FragCoord.xy;\n    float2 ab = params.b - params.a;\n    float t = fast::clamp(dot(p - params.a, ab) / fast::max(dot(ab, ab), 9.9999999747524270787835121154785e-07), 0.0, 1.0);\n    float4 g = mix(params.from_color, params.to_color, float4(t));\n    float _83;\n    if (params.selected > 0.5)\n    {\n        _83 = selection.sample(selectionSmplr, uv).x;\n    }\n    else\n    {\n        _83 = 1.0;\n    }\n    float s = _83;\n    float a = g.w * s;\n    float alpha = a + (o.w * (1.0 - a));\n    float3 _114;\n    if (alpha > 0.0)\n    {\n        _114 = ((g.xyz * a) + ((o.xyz * o.w) * (1.0 - a))) / float3(alpha);\n    }\n    else\n    {\n        _114 = float3(0.0);\n    }\n    float3 color = _114;\n    out.fragment_color = float4(color, alpha);\n    return out;\n}\n\n"

