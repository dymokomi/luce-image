pub let ants_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\n// Implementation of the GLSL mod() function, which is slightly different than Metal fmod()\ntemplate<typename Tx, typename Ty>\ninline Tx mod(Tx x, Ty y)\n{\n    return x - y * floor(x / y);\n}\n\nstruct Params\n{\n    float2 origin;\n    float zoom;\n    float phase;\n    float2 covered;\n    float2 limit;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstatic inline __attribute__((always_inline))\nfloat inside(thread const float2& texel, constant Params& params, texture2d<float> right_tile, sampler right_tileSmplr, texture2d<float> below_tile, sampler below_tileSmplr, texture2d<float> selection, sampler selectionSmplr)\n{\n    bool _20 = texel.x < 0.0;\n    bool _28;\n    if (!_20)\n    {\n        _28 = texel.y < 0.0;\n    }\n    else\n    {\n        _28 = _20;\n    }\n    bool _43;\n    if (!_28)\n    {\n        _43 = texel.x >= params.limit.x;\n    }\n    else\n    {\n        _43 = _28;\n    }\n    bool _52;\n    if (!_43)\n    {\n        _52 = texel.y >= params.limit.y;\n    }\n    else\n    {\n        _52 = _43;\n    }\n    if (_52)\n    {\n        return 0.0;\n    }\n    float2 at = floor(texel) + float2(0.5);\n    float value;\n    if (texel.x >= 256.0)\n    {\n        value = right_tile.sample(right_tileSmplr, ((at - float2(256.0, 0.0)) / float2(256.0))).x;\n    }\n    else\n    {\n        if (texel.y >= 256.0)\n        {\n            value = below_tile.sample(below_tileSmplr, ((at - float2(0.0, 256.0)) / float2(256.0))).x;\n        }\n        else\n        {\n            value = selection.sample(selectionSmplr, (at / float2(256.0))).x;\n        }\n    }\n    return float(value >= 0.5);\n}\n\nfragment luce_fragment_out luce_fragment(constant Params& params [[buffer(0)]], texture2d<float> selection [[texture(1)]], texture2d<float> right_tile [[texture(2)]], texture2d<float> below_tile [[texture(3)]], sampler selectionSmplr [[sampler(1)]], sampler right_tileSmplr [[sampler(2)]], sampler below_tileSmplr [[sampler(3)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    float2 p = (gl_FragCoord.xy - params.origin) / float2(params.zoom);\n    bool _128 = p.x < 0.0;\n    bool _135;\n    if (!_128)\n    {\n        _135 = p.y < 0.0;\n    }\n    else\n    {\n        _135 = _128;\n    }\n    bool _145;\n    if (!_135)\n    {\n        _145 = p.x >= params.covered.x;\n    }\n    else\n    {\n        _145 = _135;\n    }\n    bool _154;\n    if (!_145)\n    {\n        _154 = p.y >= params.covered.y;\n    }\n    else\n    {\n        _154 = _145;\n    }\n    if (_154)\n    {\n        out.fragment_color = float4(0.0);\n        return out;\n    }\n    float2 param = p;\n    float here = inside(param, params, right_tile, right_tileSmplr, below_tile, below_tileSmplr, selection, selectionSmplr);\n    float _step = fast::max(1.0, 1.0 / params.zoom);\n    float edge = 0.0;\n    float2 param_1 = p + float2(_step, 0.0);\n    if (inside(param_1, params, right_tile, right_tileSmplr, below_tile, below_tileSmplr, selection, selectionSmplr) != here)\n    {\n        edge = 1.0;\n    }\n    float2 param_2 = p + float2(0.0, _step);\n    if (inside(param_2, params, right_tile, right_tileSmplr, below_tile, below_tileSmplr, selection, selectionSmplr) != here)\n    {\n        edge = 1.0;\n    }\n    bool _195 = (p.x - _step) >= 0.0;\n    bool _206;\n    if (_195)\n    {\n        float2 param_3 = p - float2(_step, 0.0);\n        _206 = inside(param_3, params, right_tile, right_tileSmplr, below_tile, below_tileSmplr, selection, selectionSmplr) != here;\n    }\n    else\n    {\n        _206 = _195;\n    }\n    if (_206)\n    {\n        edge = 1.0;\n    }\n    bool _213 = (p.y - _step) >= 0.0;\n    bool _224;\n    if (_213)\n    {\n        float2 param_4 = p - float2(0.0, _step);\n        _224 = inside(param_4, params, right_tile, right_tileSmplr, below_tile, below_tileSmplr, selection, selectionSmplr) != here;\n    }\n    else\n    {\n        _224 = _213;\n    }\n    if (_224)\n    {\n        edge = 1.0;\n    }\n    if (edge < 0.5)\n    {\n        out.fragment_color = float4(0.0);\n        return out;\n    }\n    float dash = float(mod((gl_FragCoord.x + gl_FragCoord.y) + params.phase, 8.0) < 4.0);\n    out.fragment_color = float4(float3(dash), 1.0);\n    return out;\n}\n\n"

