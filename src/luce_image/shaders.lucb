pub let mask_mix_frag_msl: c.str = "#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nfragment luce_fragment_out luce_fragment(texture2d<float> before [[texture(1)]], texture2d<float> after [[texture(2)]], texture2d<float> selection [[texture(3)]], sampler beforeSmplr [[sampler(1)]], sampler afterSmplr [[sampler(2)]], sampler selectionSmplr [[sampler(3)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    int2 p = int2(gl_FragCoord.xy);\n    float4 o = before.read(uint2(p), 0);\n    float4 n = after.read(uint2(p), 0);\n    float cover = selection.read(uint2(p), 0).x;\n    float a = mix(o.w, n.w, cover);\n    float3 rgb = mix(o.xyz * o.w, n.xyz * n.w, float3(cover));\n    float3 _75;\n    if (a > 0.0)\n    {\n        _75 = rgb / float3(a);\n    }\n    else\n    {\n        _75 = float3(0.0);\n    }\n    out.fragment_color = float4(_75, a);\n    return out;\n}\n\n"
