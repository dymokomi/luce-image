pub let spread_frag_msl: c.str = "#pragma clang diagnostic ignored \"-Wmissing-prototypes\"\n\n#include <metal_stdlib>\n#include <simd/simd.h>\n\nusing namespace metal;\n\nstruct Params\n{\n    float radius;\n    float sigma;\n    float horizontal;\n    float mode;\n    float width;\n    float height;\n};\n\nstruct luce_fragment_out\n{\n    float4 fragment_color [[color(0)]];\n};\n\nstatic inline __attribute__((always_inline))\nfloat alpha_at(thread const int2& p, constant Params& params, texture2d<float> source, sampler sourceSmplr)\n{\n    bool _21 = p.x < 0;\n    bool _29;\n    if (!_21)\n    {\n        _29 = p.y < 0;\n    }\n    else\n    {\n        _29 = _21;\n    }\n    bool _44;\n    if (!_29)\n    {\n        _44 = p.x >= int(params.width);\n    }\n    else\n    {\n        _44 = _29;\n    }\n    bool _55;\n    if (!_44)\n    {\n        _55 = p.y >= int(params.height);\n    }\n    else\n    {\n        _55 = _44;\n    }\n    if (_55)\n    {\n        return 0.0;\n    }\n    return source.read(uint2(p), 0).w;\n}\n\nfragment luce_fragment_out luce_fragment(constant Params& params [[buffer(0)]], texture2d<float> source [[texture(1)]], sampler sourceSmplr [[sampler(1)]], float4 gl_FragCoord [[position]])\n{\n    luce_fragment_out out = {};\n    int2 p = int2(gl_FragCoord.xy);\n    int taps = int(params.radius);\n    float result = 0.0;\n    float weights = 0.0;\n    int _89 = -taps;\n    int2 _104;\n    for (int i = _89; i <= taps; i++)\n    {\n        if (params.horizontal > 0.5)\n        {\n            _104 = int2(p.x + i, p.y);\n        }\n        else\n        {\n            _104 = int2(p.x, p.y + i);\n        }\n        int2 q = _104;\n        int2 param = q;\n        float a = alpha_at(param, params, source, sourceSmplr);\n        if (params.mode > 0.5)\n        {\n            result = fast::max(result, a);\n        }\n        else\n        {\n            float w = exp(((-0.5) * float(i * i)) / (params.sigma * params.sigma));\n            result += (a * w);\n            weights += w;\n        }\n    }\n    if (params.mode <= 0.5)\n    {\n        result /= fast::max(weights, 9.9999999747524270787835121154785e-07);\n    }\n    out.fragment_color = float4(0.0, 0.0, 0.0, result);\n    return out;\n}\n\n"

