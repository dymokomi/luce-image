## The compositor: answers a request for one tile of the flattened document at
## a pyramid level, from a cache keyed on what the tile depends on. Level 0 is
## document pixels; level L covers 2^L by 2^L level-0 tiles in one 256 by 256
## texture, composited from every layer's own level-L tiles (luce-canvas's
## pyramid), so a zoomed-out view costs what it shows, not what the document
## holds. The key is an identity digest over the contributing layers (id,
## revision, visibility, effective opacity) plus the cell and level, so a change
## to one layer invalidates only the tiles it touches, and a change to a top
## layer's opacity never re-renders what lies below it in another tile. There is
## one way to produce pixels; export asks for level-0 tiles like the screen.
## A Blur adjustment layer is the one thing that reaches past its cell: it
## flattens what is below it in the eight cells around too, and while a
## document has one every key covers those neighbours.
import gpu
import memory
from tiles import Gathering, Tiles, Tile, tile_size, min_u32, max_u32, tile_texture, transient_mark, release_transients
from pyramid import Pyramid, covered_at, tile_bytes, precious_level
from tile_cache import TileCache
from luce_image.document import Document, Layer, fnv_start, fnv_mix
from luce_image.style import Styler
from raster_errors import invalid, limit
from half import from_half
from luce_image.shaders import composite_frag_words, composite_frag_msl, adjust_mix_frag_words, adjust_mix_frag_msl
from luce_image.adjust import Adjuster, Place, curves, blur
from luce_image.filter import Filters
from luce_image.curves import lut_size
from luce_image.stand_in import StandIn, Made, stand_in_limit

## A styled layer's rendered effects, kept while its pixels and style stand.
struct Effects:
    var key: u64
    ## Drawn under the layer's pixels; and, when the style changes the layer's
    ## own colors, the layer as it then is, drawn instead of its pixels.
    var tiles: Tiles
    var over: Tiles
    var has_over: bool
    var used: u64
    var live: bool

## A Curves adjustment layer's lookup table, kept while its curves stand.
struct CurveTable:
    var key: u64
    var texture: gpu.Texture
    var live: bool

## How many Curves layers keep their tables at once.
let curve_table_budget: usize = 4

## How many styled layers keep their effects rendered at once.
let effects_budget: usize = 8

## A coarser composite standing in for a cell whose tiles are coming back:
## its texture (borrowed like a composite) and the texels that cover the cell.
pub struct Coarser:
    pub var texture: gpu.Texture
    pub var region: gpu.Region

pub struct Composer:
    var owner: gpu.Device
    ## Composited tiles by what they depend on, and every layer's levels.
    var cache: TileCache
    var pyramid: Pyramid
    ## The level the tile being made is at.
    var level: u32
    var tick: u64
    var shader: gpu.Shader
    var pipeline: gpu.Pipeline
    var blank: gpu.Texture
    var white: gpu.Texture
    var styler: Styler
    ## Adjustment layers: the adjust pass over the backdrop, and the mix back by mask and opacity.
    var adjuster: Adjuster
    var mix_shader: gpu.Shader
    var mix: gpu.Pipeline
    var effects: Effects[8]
    var curve_tables: CurveTable[4]
    var next_curve_table: usize
    ## How many tiles were rendered rather than found, for tests and tuning.
    pub var renders: u64
    ## The document being drawn's size, for adjustments that depend on where a pixel is.
    var extent_x: u32
    var extent_y: u32
    ## Blur layers: the document being drawn, the Gaussian, and the layer a
    ## flatten stops before (0: none) and whether it has.
    var drawing: const Document*?
    var filters: Filters
    var stop_at: u64
    var stopped: bool
    ## Layers shown through a preview's stand-in rather than their tiles.
    var stand_ins: StandIn[8]
    var stand_in_count: usize
    ## What was cached while stand-ins showed: keyed by their generations, it
    ## is stale once they change, and is let go then rather than filling the
    ## cache until pushed out.
    var stand_in_keys: u64[]
    var stand_in_key_count: usize

    ## A compositor keeping at most `budget` composited tiles (512 KiB each),
    ## and as many bytes again of layer levels.
    pub static func create(device: gpu.Device, budget: usize = 1536) -> Composer!:
        if budget == 0 or budget > 65536:
            error(invalid, "the tile budget must be in 1..65536")
        var cache = try TileCache.create(budget * tile_bytes, tile_bytes)
        errdefer cache.destroy()
        var pyramid = try Pyramid.create(device, budget * tile_bytes)
        errdefer pyramid.destroy()
        var shader = try gpu.Shader.create(device, composite_frag_words, composite_frag_msl)
        errdefer shader.destroy()
        var pipeline = try gpu.Pipeline.create(device, shader, gpu.Blend.replace, gpu.Format.rgba16_float)
        errdefer pipeline.destroy()
        var blank = try tile_texture(device)
        errdefer blank.destroy()
        let zeros = try alloc u8[(usize)tile_size * (usize)tile_size * 8] in memory.heap
        defer free(zeros) in memory.heap
        for index in 0..<zeros.length:
            zeros[index] = 0
        try blank.upload(zeros)
        var white = try gpu.Texture.create(device, 1, 1, gpu.Format.rgba16_float)
        errdefer white.destroy()
        # 1.0 as a half is 0x3c00.
        try white.upload([(u8)0, (u8)0x3c, (u8)0, (u8)0x3c, (u8)0, (u8)0x3c, (u8)0, (u8)0x3c])
        var styler = try Styler.create(device)
        errdefer styler.destroy()
        var adjuster = try Adjuster.create(device)
        errdefer adjuster.destroy()
        var filters = try Filters.create(device)
        errdefer filters.destroy()
        var mix_shader = try gpu.Shader.create(device, adjust_mix_frag_words, adjust_mix_frag_msl)
        errdefer mix_shader.destroy()
        var mix = try gpu.Pipeline.create(device, mix_shader, gpu.Blend.replace, gpu.Format.rgba16_float)
        errdefer mix.destroy()
        var effects: Effects[8]
        for index in 0..<effects_budget:
            effects[index] = Effects(key = 0, tiles = Tiles(), over = Tiles(), has_over = false, used = 0, live = false)
        var stand_ins: StandIn[8] = ---
        var tables: CurveTable[4]
        for index in 0..<curve_table_budget:
            tables[index] = CurveTable(key = 0, texture = gpu.Texture(), live = false)
        return Composer(owner = device, cache = cache, pyramid = pyramid, level = 0, tick = 0, shader = shader, pipeline = pipeline, blank = blank, white = white, styler = styler,
                        adjuster = adjuster, mix_shader = mix_shader, mix = mix, effects = effects, curve_tables = tables, next_curve_table = 0, renders = 0, extent_x = 0, extent_y = 0,
                        drawing = none, filters = filters, stop_at = 0, stopped = false,
                        stand_ins = stand_ins, stand_in_count = 0)

    ## The flattened tile at `column`, `row` of pyramid `level`, borrowed until
    ## the next call. Straight-alpha rgba16_float, transparent where nothing is.
    pub mutating func tile(document: const Document*, column: u32, row: u32, level: u32) -> gpu.Texture!:
        if level > 16:
            error(invalid, "pyramid levels go up to 16")
        let span = 1u32 << level
        if column * span * tile_size >= document.width() or row * span * tile_size >= document.height():
            error(invalid, "the requested tile lies outside the document")
        self.tick += 1
        self.extent_x = document.width()
        self.extent_y = document.height()
        self.drawing = document
        self.level = level
        # What this tile fetches stays until the next request.
        self.cache.hold()
        self.pyramid.hold()
        let digest = self.composite_key(document, column, row, level)
        if let found = self.cache.find(digest | 1):
            return found
        let mark = transient_mark()
        defer release_transients(mark)
        let texture = try self.flatten(document, column, row)
        self.renders += 1
        # A zoomed-out composite is made from every layer's levels below it:
        # precious, so the view at fit keeps it while finer tiles come and go.
        try self.cache.put(digest | 1, texture, tile_bytes, precious = precious_level(document.width(), document.height(), level))
        try self.note_stand_in_key(digest | 1)
        return texture

    ## Forget the composites and `tiles`' level tiles over row `row` of cells,
    ## about to change as a picture loads into `tiles` a band at a time: made
    ## from the rows so far, they would only fill the caches until pushed out.
    pub mutating func forget_band(document: const Document*, tiles: const Tiles*, row: u32):
        var level: u32 = 0
        while level <= 16:
            let span = (u64)tile_size << level
            let columns = (u32)(((u64)document.width() + span - 1) // span)
            for column in 0..<columns:
                self.cache.forget(self.composite_key(document, column, row >> level, level) | 1)
            if (u64)document.width() <= span and (u64)document.height() <= span:
                break
            level += 1
        self.pyramid.forget_band(tiles, row, false)

    ## What the composite of cell (`column`, `row`) at `level` is made from, as
    ## a key: every contributing layer's cells by stamp, and the stand-ins shown.
    func composite_key(document: const Document*, column: u32, row: u32, level: u32) -> u64:
        let span = 1u32 << level
        var digest = fnv_start()
        digest = fnv_mix(digest, (u64)level)
        digest = fnv_mix(digest, (u64)column)
        digest = fnv_mix(digest, (u64)row)
        digest = fnv_mix(digest, (u64)document.width())
        digest = fnv_mix(digest, (u64)document.height())
        if has_blur(document.layers()):
            # What is below a blur in the cells around shows through it.
            let first_column = column * span - 1 if column > 0 else 0
            let first_row = row * span - 1 if row > 0 else 0
            digest = hash_layers(digest, document.layers(), 1.0, first_column, first_row, span + 2)
        else:
            digest = hash_layers(digest, document.layers(), 1.0, column * span, row * span, span)
        for index in 0..<self.stand_in_count:
            digest = fnv_mix(digest, self.stand_ins[index].layer * 2 + (1 if self.stand_ins[index].mask else 0))
            digest = fnv_mix(digest, self.stand_ins[index].generation)
        return digest

    ## Bring into RAM together the layer tiles that the composites of cells
    ## `first_column..<last_column` by `first_row..<last_row` at `level` not
    ## yet kept would otherwise bring back one at a time, each decoded on this
    ## thread (luce-canvas tiles/gathering). A draw calls it before asking for
    ## the cells; a tile it misses (a blur's neighbors) still comes back alone.
    pub mutating func gather(document: const Document*, first_column: u32, first_row: u32, last_column: u32, last_row: u32, level: u32) -> !:
        var pending = Gathering.create()
        for row in first_row..<last_row:
            for column in first_column..<last_column:
                if self.cache.has(self.composite_key(document, column, row, level) | 1):
                    continue
                try self.gather_layers(document.layers(), column, row, level, &pending)
        try pending.finish()

    ## Whether the composite of cell (`column`, `row`) at `level` is kept.
    pub mutating func kept(document: const Document*, column: u32, row: u32, level: u32) -> bool:
        return self.cache.has(self.composite_key(document, column, row, level) | 1)

    ## Add to `pending` (deferred) the layer tiles making that composite would
    ## bring back; how many it lacks.
    pub mutating func lacking(document: const Document*, column: u32, row: u32, level: u32, pending: Gathering*) -> usize!:
        let before = pending.missing()
        try self.gather_layers(document.layers(), column, row, level, pending)
        return pending.missing() - before

    ## The nearest coarser composite kept that covers cell (`column`, `row`) of
    ## `level` (whose covered texels are `covered_x` by `covered_y`), and the
    ## texels of it that stand for the cell; none when no coarser one is kept.
    pub mutating func coarser(document: const Document*, column: u32, row: u32, level: u32, covered_x: u32, covered_y: u32) -> Coarser?:
        for up in 1..<(u32)8:
            let coarse = level + up
            if coarse > 16:
                break
            let found = self.cache.find(self.composite_key(document, column >> up, row >> up, coarse) | 1) else continue
            let side = tile_size >> up
            let x = (column - ((column >> up) << up)) * side
            let y = (row - ((row >> up) << up)) * side
            let step = 1u32 << up
            return Coarser(texture = found, region = gpu.Region(x, y, max_u32(1, (covered_x + step - 1) >> up), max_u32(1, (covered_y + step - 1) >> up)))
        return none

    func gather_layers(layers: Layer*[], column: u32, row: u32, level: u32, pending: Gathering*) -> !:
        for layer in layers:
            if not layer.visible or layer.opacity == 0.0:
                continue
            if let mask_tiles = layer.active_mask():
                try self.pyramid.gather(mask_tiles, column, row, level, true, pending)
            if layer.group:
                try self.gather_layers(layer.layers(), column, row, level, pending)
            elif let tiles = layer.tiles():
                try self.pyramid.gather(tiles, column, row, level, false, pending)

    ## Cell (`column`, `row`) of any store at `level`, for drawing outside a
    ## composite (thumbnails, marching ants, a layer being moved): borrowed
    ## until the next `hold` or composite request; none where it is empty.
    pub mutating func level_texture(tiles: const Tiles*, column: u32, row: u32, level: u32, mask: bool = false) -> gpu.Texture?!:
        return try self.pyramid.texture(tiles, column, row, level, mask)

    ## Begin a drawing request whose level tiles must stay until it is done.
    pub mutating func hold():
        self.cache.hold()
        self.pyramid.hold()

    ## A layer's (or mask's) tile at the level being made; none where it is
    ## empty. A level-0 tile kept in RAM comes up for this composite alone
    ## (released when `tile` has made it), so compositing a document mostly in
    ## RAM costs uploads rather than GPU memory.
    mutating func source(tiles: const Tiles*, column: u32, row: u32, mask: bool = false) -> gpu.Texture?!:
        return try self.pyramid.pass_texture(tiles, column, row, self.level, mask)

    ## Show layer `stand_in.layer` (or its mask) through `stand_in` until
    ## `drop_stand_ins`, replacing one it has already; a new generation
    ## redraws every tile it reaches.
    pub mutating func stand_in(stand_in: StandIn) -> !:
        for index in 0..<self.stand_in_count:
            if self.stand_ins[index].layer == stand_in.layer and self.stand_ins[index].mask == stand_in.mask:
                if self.stand_ins[index].generation != stand_in.generation:
                    self.forget_stand_in_keys()
                self.stand_ins[index] = stand_in
                return
        if self.stand_in_count == stand_in_limit:
            error(limit, "a preview shows at most 8 layers and masks")
        self.stand_ins[self.stand_in_count] = stand_in
        self.stand_in_count += 1

    ## Show every layer through its own tiles again.
    pub mutating func drop_stand_ins():
        self.stand_in_count = 0
        self.forget_stand_in_keys()

    ## Remember `key`, cached while stand-ins show, to let it go with them.
    mutating func note_stand_in_key(key: u64) -> !:
        if self.stand_in_count == 0:
            return
        if self.stand_in_key_count == self.stand_in_keys.length:
            let grown = try alloc u64[self.stand_in_keys.length * 2 + 64] in memory.heap
            for index in 0..<self.stand_in_key_count:
                grown[index] = self.stand_in_keys[index]
            if self.stand_in_keys.length > 0:
                free(self.stand_in_keys) in memory.heap
            self.stand_in_keys = grown
        self.stand_in_keys[self.stand_in_key_count] = key
        self.stand_in_key_count += 1

    ## Let go of what was cached for the stand-ins as they were.
    mutating func forget_stand_in_keys():
        for index in 0..<self.stand_in_key_count:
            self.cache.forget(self.stand_in_keys[index])
        self.stand_in_key_count = 0

    ## The layer levels it keeps: what a stand-in reads, for work made outside a draw.
    pub mutating func levels() -> Pyramid*:
        return &self.pyramid

    ## `layer`'s tile (or its mask's) at the level being made: its stand-in's
    ## while a preview shows one, else its own `tiles`'.
    mutating func layer_source(layer: const Layer*, tiles: const Tiles*, column: u32, row: u32, mask: bool = false) -> gpu.Texture?!:
        for index in 0..<self.stand_in_count:
            let stand_in = self.stand_ins[index]
            if stand_in.layer != layer.id or stand_in.mask != mask:
                continue
            # Made once per generation, cell and level, then cached like a composite.
            var key = fnv_start()
            key = fnv_mix(key, 0x5374616e64496e)
            key = fnv_mix(key, stand_in.layer * 2 + (1 if mask else 0))
            key = fnv_mix(key, stand_in.generation)
            key = fnv_mix(key, (u64)self.level)
            key = fnv_mix(key, (u64)column)
            key = fnv_mix(key, (u64)row)
            key = key & ~(u64)1
            if let found = self.cache.find(key):
                return found
            let make = stand_in.make else return try self.source(tiles, column, row, mask)
            let result = try make(stand_in.context, &self.pyramid, stand_in.layer, mask, column, row, self.level)
            if result.original:
                return try self.source(tiles, column, row, mask)
            let texture = result.texture else return none
            try self.cache.put(key, texture, tile_bytes)
            try self.note_stand_in_key(key)
            return texture
        return try self.source(tiles, column, row, mask)

    ## The texels a cell covers at the level being made.
    func region_at(column: u32, row: u32) -> gpu.Region:
        return gpu.Region(0, 0, covered_at(self.extent_x, column, self.level), covered_at(self.extent_y, row, self.level))

    ## A level-0 tile: every contributing layer composited in turn over the
    ## result so far, through the blend shader, each pass into a fresh tile.
    mutating func flatten(document: const Document*, column: u32, row: u32) -> gpu.Texture!:
        var backdrop = self.blank
        var owned = false
        errdefer drop_owned(&backdrop, owned)
        try self.flatten_layers(document.layers(), 1.0, column, row, &backdrop, &owned)
        if not owned:
            # Nothing contributed: a transparent tile of its own, so the cache can destroy it.
            backdrop = try tile_texture(self.owner)
            let frame = try backdrop.frame()
            defer frame.release()
            discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))
        return backdrop

    mutating func flatten_layers(layers: Layer*[], opacity: f64, column: u32, row: u32, backdrop: gpu.Texture*, owned: bool*) -> !:
        # The layer a clipped layer takes its alpha from: the nearest unclipped
        # raster layer below it in this group.
        var base: gpu.Texture? = none
        var base_missing = false
        for layer in layers:
            if self.stopped:
                return
            if layer.id == self.stop_at:
                self.stopped = true
                return
            if not layer.visible or layer.opacity == 0.0:
                continue
            let effective = opacity * layer.opacity
            if layer.group:
                if let group_mask = layer.active_mask():
                    try self.masked_group(layer, group_mask, effective, column, row, backdrop, owned)
                else:
                    try self.flatten_layers(layer.layers(), effective, column, row, backdrop, owned)
                base = none
                base_missing = false
                continue
            if layer.adjustment >= 0:
                # Live: what is below, adjusted, mixed back by opacity, mask and
                # (clipped) the base's alpha. It is never a clipping base itself.
                var mask = self.white
                if let mask_tiles = layer.active_mask():
                    if let mask_texture = try self.source(mask_tiles, column, row, true):
                        mask = mask_texture
                var clip = self.white
                if layer.clipped:
                    clip = self.blank if base_missing else (base else self.blank)
                try self.adjust(backdrop, owned, layer, mask, clip, effective, column, row)
                continue
            let tiles = layer.tiles() else continue
            if not layer.clipped:
                base = try self.layer_source(layer, tiles, column, row)
                base_missing = base == none
            let area = self.region_at(column, row)
            var clip = self.blank if layer.clipped and base_missing else (base else self.blank)
            if not layer.clipped:
                clip = self.white
            var mask = self.white
            if let mask_tiles = layer.active_mask():
                if let mask_texture = try self.layer_source(layer, mask_tiles, column, row, true):
                    mask = mask_texture
            # The layer's effects go under it, with its opacity and mask, blended
            # normally; those inside it (overlay, inner shadow, an inside stroke)
            # come as the layer itself, recolored.
            var texture = try self.layer_source(layer, tiles, column, row)
            if layer.style.any():
                let effects = try self.effects_for(layer)
                if let effect = try self.source(&effects.tiles, column, row):
                    try self.pass(backdrop, owned, effect, mask, clip, area, effective, 0)
                if effects.has_over:
                    texture = try self.source(&effects.over, column, row)
            let drawn = texture else continue
            try self.pass(backdrop, owned, drawn, mask, clip, area, effective, layer.blend)

    ## A group with a mask: its layers flattened on their own, then laid over
    ## the backdrop through the mask at the group's opacity.
    mutating func masked_group(group: const Layer*, mask_tiles: const Tiles*, opacity: f64, column: u32, row: u32, backdrop: gpu.Texture*, owned: bool*) -> !:
        var inside = self.blank
        var inside_owned = false
        defer drop_owned(&inside, inside_owned)
        try self.flatten_layers(group.layers(), 1.0, column, row, &inside, &inside_owned)
        if self.stopped:
            # Stopped inside: what the group holds so far is the backdrop there.
            drop_owned(backdrop, *owned)
            *backdrop = inside
            *owned = inside_owned
            inside_owned = false
            return
        if not inside_owned:
            return
        let mask = (try self.source(mask_tiles, column, row, true)) else self.white
        try self.pass(backdrop, owned, inside, mask, self.white, self.region_at(column, row), opacity, 0)

    ## One layer (or effects) tile composited over the backdrop so far.
    mutating func pass(backdrop: gpu.Texture*, owned: bool*, texture: gpu.Texture, mask: gpu.Texture, clip: gpu.Texture, area: gpu.Region, opacity: f64, blend: u32) -> !:
        var params: f32[6] = [0.0, 0.0, (f32)area.width, (f32)area.height, (f32)opacity, (f32)blend]
        var fresh = try tile_texture(self.owner)
        errdefer fresh.destroy()
        let frame = try fresh.frame()
        defer frame.release()
        let target = try frame.value().target()
        defer target.release()
        try gpu.shade(target.value(), self.pipeline, gpu.Rect(width = (f64)tile_size, height = (f64)tile_size), u8[]((u8*)&params[0], 24), [*backdrop, texture, mask, clip], gpu.Filter.nearest)
        discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))
        if *owned:
            backdrop.destroy()
        *backdrop = fresh
        *owned = true

    ## An adjustment layer applied to the backdrop so far; nothing below,
    ## nothing to adjust — but a blur, whose neighbours may bleed in.
    mutating func adjust(backdrop: gpu.Texture*, owned: bool*, layer: const Layer*, mask: gpu.Texture, clip: gpu.Texture, opacity: f64, column: u32, row: u32) -> !:
        if not *owned and layer.adjustment != (i64)blur:
            return
        var adjusted = gpu.Texture()
        if layer.adjustment == (i64)blur:
            adjusted = try self.blurred(*backdrop, layer, column, row)
        else:
            let table = try self.curve_table_for(layer)
            # Where the tile lies, in the level's pixels.
            let place = Place(x = column * tile_size, y = row * tile_size, width = (u32)(((u64)self.extent_x + (1u64 << self.level) - 1) >> self.level),
                              height = (u32)(((u64)self.extent_y + (1u64 << self.level) - 1) >> self.level))
            adjusted = try self.adjuster.adjusted(*backdrop, (u32)layer.adjustment, layer.adjustment_values[..<23], table, place)
        defer adjusted.destroy()
        var params: f32[1] = [(f32)opacity]
        var fresh = try tile_texture(self.owner)
        errdefer fresh.destroy()
        let frame = try fresh.frame()
        defer frame.release()
        let target = try frame.value().target()
        defer target.release()
        try gpu.shade(target.value(), self.mix, gpu.Rect(width = (f64)tile_size, height = (f64)tile_size), u8[]((u8*)&params[0], 4), [*backdrop, adjusted, mask, clip], gpu.Filter.nearest)
        discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))
        drop_owned(backdrop, *owned)
        *backdrop = fresh
        *owned = true

    ## What is below Blur layer `layer` at the cell, `middle`, blurred with
    ## what is below it in the cells around (flattened up to it), as a fresh
    ## texture.
    mutating func blurred(middle: gpu.Texture, layer: const Layer*, column: u32, row: u32) -> gpu.Texture!:
        let document = self.drawing else error(invalid, "a blur layer is drawn within a document")
        var block = try Tiles.create(self.owner, tile_size * 3, tile_size * 3)
        defer block.destroy()
        var dy: i64 = -1
        while dy <= 1:
            var dx: i64 = -1
            while dx <= 1:
                let x = (i64)column + dx
                let y = (i64)row + dy
                if x >= 0 and y >= 0 and ((x * (i64)tile_size) << (i64)self.level) < (i64)self.extent_x and ((y * (i64)tile_size) << (i64)self.level) < (i64)self.extent_y:
                    var texture = gpu.Texture()
                    if dx == 0 and dy == 0:
                        texture = try block.blank()
                        errdefer texture.destroy()
                        try copy_tile(&texture, middle)
                    else:
                        texture = try self.flatten_until(document, (u32)x, (u32)y, layer.id)
                    try block.set((u32)(dx + 1), (u32)(dy + 1), texture)
                dx += 1
            dy += 1
        # A coarser level blurs by as many of its own, larger, texels.
        try self.filters.blur_tiles(&block, clamp_radius(layer.adjustment_values[0] / (f64)(1u64 << self.level)))
        var result = try block.blank()
        errdefer result.destroy()
        if let blurred = (try block.texture(1, 1)):
            try copy_tile(&result, blurred)
        return result

    ## The level-0 cell as flattened up to layer `stop` (not including it), a
    ## fresh texture; transparent when nothing is below it there.
    mutating func flatten_until(document: const Document*, column: u32, row: u32, stop: u64) -> gpu.Texture!:
        let outer_stop = self.stop_at
        let outer_stopped = self.stopped
        self.stop_at = stop
        self.stopped = false
        var backdrop = self.blank
        var owned = false
        self.flatten_layers(document.layers(), 1.0, column, row, &backdrop, &owned) catch failure:
            drop_owned(&backdrop, owned)
            self.stop_at = outer_stop
            self.stopped = outer_stopped
            error(failure.code, failure.message)
        self.stop_at = outer_stop
        self.stopped = outer_stopped
        if owned:
            return backdrop
        var clear = try tile_texture(self.owner)
        errdefer clear.destroy()
        let frame = try clear.frame()
        defer frame.release()
        discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))
        return clear

    ## A Curves layer's lookup table, made once per state of its curves; none
    ## for any other kind.
    mutating func curve_table_for(layer: const Layer*) -> gpu.Texture?!:
        if layer.adjustment != (i64)curves:
            return none
        var key = fnv_start()
        key = fnv_mix(key, layer.id)
        key = fnv_mix(key, layer.revision)
        for index in 0..<curve_table_budget:
            if self.curve_tables[index].live and self.curve_tables[index].key == key:
                return self.curve_tables[index].texture
        var texture = try gpu.Texture.create(self.owner, (u32)lut_size, 1, gpu.Format.rgba8_linear)
        errdefer texture.destroy()
        var bytes: u8[1024]
        try layer.curves.fill(bytes)
        try texture.upload(bytes)
        let slot = self.next_curve_table
        self.next_curve_table = (slot + 1) % curve_table_budget
        if self.curve_tables[slot].live:
            self.curve_tables[slot].texture.destroy()
        self.curve_tables[slot] = CurveTable(key = key, texture = texture, live = true)
        return texture

    ## The effects tiles for a styled layer, rendered once per pixels-and-style state.
    mutating func effects_for(layer: const Layer*) -> const Effects*!:
        var key = fnv_start()
        key = fnv_mix(key, layer.id)
        key = fnv_mix(key, layer.revision)
        key = fnv_mix(key, layer.style.digest())
        if let tiles = layer.tiles():
            key = tiles.stamps(key)
        for index in 0..<effects_budget:
            if self.effects[index].live and self.effects[index].key == key:
                self.effects[index].used = self.tick
                return &self.effects[index]
        var rendered = try self.styler.render(layer)
        errdefer rendered.destroy()
        var slot: usize = 0
        for index in 1..<effects_budget:
            if not self.effects[index].live and self.effects[slot].live:
                slot = index
            elif self.effects[index].live == self.effects[slot].live and self.effects[index].used < self.effects[slot].used:
                slot = index
        if self.effects[slot].live:
            drop_effects(&self.effects[slot])
        self.effects[slot] = Effects(key = key, tiles = rendered.under, over = rendered.over, has_over = rendered.has_over, used = self.tick, live = true)
        return &self.effects[slot]

    ## Merge `upper` into the layer directly below it: every tile of the lower
    ## layer becomes the two composited with the upper's opacity, blend, mask
    ## and clipping; the upper layer is then removed.
    pub mutating func merge_down(document: Document*, upper: u64) -> !:
        let top = document.find(upper) else error(invalid, "no such layer")
        let lower = document.below(upper) else error(invalid, "nothing below to merge into")
        if top.group or lower.group:
            error(invalid, "groups cannot be merged yet")
        let source = top.tiles() else error(invalid, "no pixels to merge")
        let tiles = lower.tiles() else error(invalid, "no pixels to merge into")
        for row in 0..<tiles.rows():
            for column in 0..<tiles.columns():
                let texture = (try source.texture(column, row)) else continue
                let area = tiles.region(column, row)
                let backdrop = (try tiles.texture(column, row)) else self.blank
                var mask = self.white
                if let mask_tiles = top.active_mask():
                    if let mask_texture = (try mask_tiles.texture(column, row)):
                        mask = mask_texture
                let clip = ((try tiles.texture(column, row)) else self.blank) if top.clipped else self.white
                var params: f32[6] = [0.0, 0.0, (f32)area.width, (f32)area.height, (f32)top.opacity, (f32)top.blend]
                var fresh = try tile_texture(self.owner)
                errdefer fresh.destroy()
                let frame = try fresh.frame()
                defer frame.release()
                let target = try frame.value().target()
                defer target.release()
                try gpu.shade(target.value(), self.pipeline, gpu.Rect(width = (f64)tile_size, height = (f64)tile_size), u8[]((u8*)&params[0], 24), [backdrop, texture, mask, clip], gpu.Filter.nearest)
                discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))
                try tiles.set(column, row, fresh)
        lower.revision += 1
        try document.remove(upper)

    ## Forget every rendered tile.
    pub mutating func clear():
        self.cache.clear()
        self.pyramid.clear()
        for index in 0..<effects_budget:
            if self.effects[index].live:
                drop_effects(&self.effects[index])
                self.effects[index].live = false

    pub mutating func destroy():
        if self.stand_in_keys.length > 0:
            free(self.stand_in_keys) in memory.heap
        var no_keys: u64[]
        self.stand_in_keys = no_keys
        self.stand_in_key_count = 0
        self.clear()
        self.cache.destroy()
        self.pyramid.destroy()
        for index in 0..<curve_table_budget:
            if self.curve_tables[index].live:
                self.curve_tables[index].texture.destroy()
                self.curve_tables[index].live = false
        self.styler.destroy()
        self.mix.destroy()
        self.mix_shader.destroy()
        self.adjuster.destroy()
        self.filters.destroy()
        self.blank.destroy()
        self.white.destroy()
        self.pipeline.destroy()
        self.shader.destroy()

## Move a compositor onto the heap, for holders that keep a pointer.
pub func box_composer(composer: Composer) -> Composer*!:
    # The whole value at once: a field-by-field copy left new fields zero.
    let boxed = try new Composer in memory.heap
    *boxed = composer
    return boxed

## Destroy a boxed compositor and free the box.
pub func unbox_composer(composer: Composer*):
    composer.destroy()
    free(composer) in memory.heap

## Whether any visible layer among `layers` (or in their groups) is a Blur layer.
func has_blur(layers: Layer*[]) -> bool:
    for layer in layers:
        if not layer.visible:
            continue
        if layer.adjustment == (i64)blur or (layer.group and has_blur(layer.layers())):
            return true
    return false

## A Blur layer's radius as the Gaussian takes it.
func clamp_radius(radius: f64) -> f64:
    return radius if radius >= 0.5 and radius <= 250.0 else (0.5 if not (radius > 0.5) else 250.0)

## Every texel of `source` into `target`, both whole tiles.
func copy_tile(target: gpu.Texture*, source: gpu.Texture) -> !:
    let frame = try target.frame()
    defer frame.release()
    let whole = try frame.value().target()
    defer whole.release()
    try gpu.copy_image(whole.value(), source, gpu.Rect(0.0, 0.0, (f64)tile_size, (f64)tile_size), gpu.Region(0, 0, tile_size, tile_size))
    discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))

## Fold every layer that contributes to the cells in range into `digest`.
func hash_layers(seed: u64, layers: Layer*[], opacity: f64, first_column: u32, first_row: u32, span: u32) -> u64:
    var digest = seed
    for layer in layers:
        if not layer.visible or layer.opacity == 0.0:
            continue
        let effective = opacity * layer.opacity
        if layer.group:
            if let mask_tiles = layer.active_mask():
                # Flattened on its own at full opacity, then laid down through its mask.
                digest = fnv_mix(digest, layer.id)
                digest = fnv_mix(digest, effective.bits())
                for row in first_row..<min_u32(first_row + span, mask_tiles.rows()):
                    for column in first_column..<min_u32(first_column + span, mask_tiles.columns()):
                        digest = fnv_mix(digest, mask_tiles.stamp(column, row))
                digest = hash_layers(digest, layer.layers(), 1.0, first_column, first_row, span)
                continue
            digest = hash_layers(digest, layer.layers(), effective, first_column, first_row, span)
            continue
        if layer.adjustment >= 0:
            # It touches every tile; its revision moves with its settings and mask.
            digest = fnv_mix(digest, layer.id)
            digest = fnv_mix(digest, layer.revision)
            digest = fnv_mix(digest, effective.bits())
            digest = fnv_mix(digest, 1 if layer.clipped else 0)
            digest = fnv_mix(digest, 1 if layer.mask_enabled else 0)
            continue
        let tiles = layer.tiles() else continue
        # The cells in range, by content stamp: painting one cell leaves every
        # other tile (and pyramid tile) cached.
        var touches = false
        var cells = fnv_start()
        for row in first_row..<min_u32(first_row + span, tiles.rows()):
            for column in first_column..<min_u32(first_column + span, tiles.columns()):
                let stamp = tiles.stamp(column, row)
                if stamp != 0:
                    touches = true
                cells = fnv_mix(cells, stamp)
        # A style's effects can reach cells the layer has no pixels in (a shadow, a glow).
        if not touches and not layer.style.any():
            continue
        digest = fnv_mix(digest, layer.id)
        digest = fnv_mix(digest, layer.revision)
        digest = fnv_mix(digest, cells)
        if let mask_tiles = layer.active_mask():
            for row in first_row..<min_u32(first_row + span, mask_tiles.rows()):
                for column in first_column..<min_u32(first_column + span, mask_tiles.columns()):
                    digest = fnv_mix(digest, mask_tiles.stamp(column, row))
        digest = fnv_mix(digest, effective.bits())
        digest = fnv_mix(digest, (u64)layer.blend)
        digest = fnv_mix(digest, 1 if layer.clipped else 0)
        if layer.style.any():
            # Effects reach across cells: every pixel of the layer counts.
            digest = fnv_mix(digest, layer.style.digest())
            digest = tiles.stamps(digest)
    return digest

func drop_effects(effects: Effects*):
    effects.tiles.destroy()
    if effects.has_over:
        effects.over.destroy()
    effects.has_over = false

func drop_owned(texture: gpu.Texture*, owned: bool):
    if owned:
        texture.destroy()


test "composite flattens layers with opacity, caches by identity and scales levels":
    var device = gpu.Device.open() catch failure:
        assert(failure.code == gpu.unavailable)
        return
    defer device.destroy()
    var document = try Document.create(device, 300, 260)
    defer document.destroy()
    let count = (usize)300 * 260 * 4
    let pixels = try alloc f32[count] in memory.heap
    defer free(pixels) in memory.heap
    for index in 0..<count:
        pixels[index] = 0.0
    # Bottom: opaque red over the top-left 300x260; top: 50% green pixel at (20, 10).
    for index in 0..<(usize)(300 * 260):
        pixels[index * 4] = 1.0
        pixels[index * 4 + 3] = 1.0
    let bottom = try document.add_layer("Bottom")
    var red = try Tiles.create(device, 300, 260)
    try red.write(pixels)
    try document.set_tiles(bottom, red)
    for index in 0..<count:
        pixels[index] = 0.0
    pixels[(10 * 300 + 20) * 4 + 1] = 1.0
    pixels[(10 * 300 + 20) * 4 + 3] = 0.5
    let top = try document.add_layer("Top")
    var green = try Tiles.create(device, 300, 260)
    try green.write(pixels)
    try document.set_tiles(top, green)
    var composer = try Composer.create(device, 4)
    defer composer.destroy()
    let flat = try composer.tile(&document, 0, 0, 0)
    assert(composer.renders == 1)
    var bytes: u8[8]
    try flat.read(bytes, gpu.Region(20, 10, 1, 1))
    let r = from_half((u16)bytes[0] | ((u16)bytes[1] << 8))
    let g = from_half((u16)bytes[2] | ((u16)bytes[3] << 8))
    let a = from_half((u16)bytes[6] | ((u16)bytes[7] << 8))
    assert(r > 0.49 and r < 0.51 and g > 0.49 and g < 0.51 and a == 1.0)
    # The same request is a cache hit; a change to the top layer is not, and
    # hiding it leaves the bottom-only tile at (1, 1) untouched.
    discard(try composer.tile(&document, 0, 0, 0))
    assert(composer.renders == 1)
    discard(try composer.tile(&document, 1, 1, 0))
    assert(composer.renders == 2)
    try document.set_appearance(top, true, 0.25)
    discard(try composer.tile(&document, 0, 0, 0))
    assert(composer.renders == 3)
    discard(try composer.tile(&document, 1, 1, 0))
    assert(composer.renders == 3)
    # Level 1 covers the whole document in one tile.
    let coarse = try composer.tile(&document, 0, 0, 1)
    try coarse.read(bytes, gpu.Region(100, 100, 1, 1))
    assert(from_half((u16)bytes[0] | ((u16)bytes[1] << 8)) > 0.99)
    try coarse.read(bytes, gpu.Region(200, 200, 1, 1))
    assert(from_half((u16)bytes[6] | ((u16)bytes[7] << 8)) == 0.0)
    # Multiply: half-alpha green over red blends to black where it lands, so
    # the pixel is half red; the cache key sees the mode change.
    try document.set_appearance(top, true, 1.0, 2)
    let multiplied = try composer.tile(&document, 0, 0, 0)
    try multiplied.read(bytes, gpu.Region(20, 10, 1, 1))
    let red_left = from_half((u16)bytes[0] | ((u16)bytes[1] << 8))
    assert(red_left > 0.49 and red_left < 0.51 and from_half((u16)bytes[2] | ((u16)bytes[3] << 8)) < 0.01)
    assert(from_half((u16)bytes[6] | ((u16)bytes[7] << 8)) == 1.0)
    # A mask painted black at the pixel hides the top layer there; clipping the
    # top layer to an empty layer below hides it everywhere.
    try document.set_appearance(top, true, 1.0, 0)
    try document.set_mask(top, true)
    var hide = try Tiles.create(device, 300, 260)
    for index in 0..<count:
        pixels[index] = 0.0
    for index in 0..<(usize)(300 * 260):
        pixels[index * 4 + 3] = 1.0
    pixels[(10 * 300 + 20) * 4 + 3] = 1.0
    pixels[(10 * 300 + 21) * 4] = 1.0
    pixels[(10 * 300 + 21) * 4 + 3] = 1.0
    try hide.write(pixels)
    let old_mask = try document.take_mask(top, hide)
    var dropped = old_mask
    dropped.destroy()
    let masked = try composer.tile(&document, 0, 0, 0)
    try masked.read(bytes, gpu.Region(20, 10, 1, 1))
    assert(from_half((u16)bytes[0] | ((u16)bytes[1] << 8)) > 0.99 and from_half((u16)bytes[2] | ((u16)bytes[3] << 8)) < 0.01)
    try document.set_mask(top, false)
    let between = try document.add_layer("Empty")
    try document.remove(between)
    let holder = try document.add_group("Holder")
    let clipped = try document.add_layer("Clipped", holder)
    try document.set_tiles(clipped, try green.clone())
    try document.set_clipped(clipped, true)
    let alone = try composer.tile(&document, 0, 0, 0)
    try alone.read(bytes, gpu.Region(20, 10, 1, 1))
    # The top (unclipped, green at half alpha) still shows; the clipped copy in
    # the group has no base and adds nothing: red 0.5 as before.
    let clipped_red = from_half((u16)bytes[0] | ((u16)bytes[1] << 8))
    assert(clipped_red > 0.49 and clipped_red < 0.51)
    var rejected = false
    discard(composer.tile(&document, 4, 0, 0) catch failure:
        assert(failure.code == invalid)
        rejected = true
        recover coarse)
    assert(rejected)

test "a styled layer's glow is composited under it":
    var device = gpu.Device.open() catch failure:
        assert(failure.code == gpu.unavailable)
        return
    defer device.destroy()
    var document = try Document.create(device, 64, 64)
    defer document.destroy()
    let count = (usize)64 * 64 * 4
    let pixels = try alloc f32[count] in memory.heap
    defer free(pixels) in memory.heap
    for index in 0..<count:
        pixels[index] = 0.0
    for y in 24..<(usize)40:
        for x in 24..<(usize)40:
            pixels[(y * 64 + x) * 4] = 1.0
            pixels[(y * 64 + x) * 4 + 3] = 1.0
    let id = try document.add_layer("Square")
    var tiles = try Tiles.create(device, 64, 64)
    try tiles.write(pixels)
    try document.set_tiles(id, tiles)
    var composer = try Composer.create(device, 4)
    defer composer.destroy()
    var plain = try composer.tile(&document, 0, 0, 0)
    let bytes = try alloc u8[(usize)tile_size * (usize)tile_size * 8] in memory.heap
    defer free(bytes) in memory.heap
    try plain.read(bytes)
    assert(bytes[(32 * 256 + 12) * 8 + 7] == 0)
    (document.find(id) else trap("layer")).style.glow = true
    (document.find(id) else trap("layer")).style.glow_size = 10.0
    var glowing = try composer.tile(&document, 0, 0, 0)
    try glowing.read(bytes)
    # The half at byte 6..7 is alpha; a glow beside the square makes it nonzero.
    assert(bytes[(32 * 256 + 20) * 8 + 7] != 0)
    assert(composer.renders == 2)

test "a blur layer softens what is below it across cell edges, and the cache follows its neighbours":
    var device = gpu.Device.open() catch failure:
        assert(failure.code == gpu.unavailable)
        return
    defer device.destroy()
    var document = try Document.create(device, 512, 64)
    defer document.destroy()
    let layer = try document.add_layer("Bar")
    let count = (usize)512 * 64 * 4
    let pixels = try alloc f32[count] in memory.heap
    defer free(pixels) in memory.heap
    for index in 0..<count:
        pixels[index] = 0.0
    # Opaque white on the left cell up to its edge.
    for y in 0..<(usize)64:
        for x in 0..<(usize)256:
            for channel in 0..<(usize)4:
                pixels[(y * 512 + x) * 4 + channel] = 1.0
    var tiles = try Tiles.create(device, 512, 64)
    try tiles.write(pixels)
    try document.set_tiles(layer, tiles)
    let values: f64[1] = [6.0]
    discard(try document.add_adjustment("Blur", (i64)blur, values))
    var composer = try Composer.create(device)
    defer composer.destroy()
    let right = try composer.tile(&document, 1, 0, 0)
    let bytes = try alloc u8[(usize)tile_size * (usize)tile_size * 8] in memory.heap
    defer free(bytes) in memory.heap
    try right.read(bytes)
    # Just right of the edge the white bleeds in (alpha half in f16 bytes 6..7).
    let at = ((usize)32 * (usize)tile_size + 2) * 8
    let alpha = from_half((u16)bytes[at + 6] | ((u16)bytes[at + 7] << 8))
    assert(alpha > 0.1 and alpha < 0.6)
    # Painting the left cell changes the right cell's key.
    let before = composer.renders
    for y in 0..<(usize)64:
        for x in 0..<(usize)256:
            pixels[(y * 512 + x) * 4 + 3] = 0.0
    let current = (document.find(layer) else trap("layer")).tiles() else trap("tiles")
    try current.write(pixels)
    discard(try composer.tile(&document, 1, 0, 0))
    assert(composer.renders == before + 1)
