## A layered document: a tree of layers over a canvas of fixed size, each
## raster layer holding shared GPU tiles in document space. Groups hold layers
## bottom to top and are pass-through: their opacity multiplies into their
## children and their visibility gates them. Editing replaces a layer's tiles;
## every replacement bumps revisions that the compositor keys its cache on.
import gpu
import math
import memory
import strings
from luce_image.tiles import Tiles, box, unbox
from luce_image.selection import Selection
from raster_errors import invalid, limit

pub let blend_mode_count: u32 = 26

## A layer's styles, Photoshop's layer effects drawn under its pixels by the
## compositor and kept with the layer; none is on by default. Colors are
## linear light, 0..1; sizes and offsets in document pixels.
pub struct Style:
    pub var shadow: bool = false
    pub var shadow_dx: f64 = 4.0
    pub var shadow_dy: f64 = 4.0
    pub var shadow_blur: f64 = 4.0
    pub var shadow_red: f64 = 0.0
    pub var shadow_green: f64 = 0.0
    pub var shadow_blue: f64 = 0.0
    pub var shadow_opacity: f64 = 0.75
    pub var stroke: bool = false
    pub var stroke_size: f64 = 3.0
    pub var stroke_red: f64 = 0.0
    pub var stroke_green: f64 = 0.0
    pub var stroke_blue: f64 = 0.0
    pub var stroke_opacity: f64 = 1.0
    pub var glow: bool = false
    pub var glow_size: f64 = 8.0
    pub var glow_red: f64 = 1.0
    pub var glow_green: f64 = 1.0
    pub var glow_blue: f64 = 1.0
    pub var glow_opacity: f64 = 0.75

    ## Whether any effect is on.
    pub func any() -> bool:
        return self.shadow or self.stroke or self.glow

    ## A digest of every setting, for caches.
    pub func digest() -> u64:
        var mixed: u64 = 0xcbf29ce484222325
        for value in [self.shadow_dx, self.shadow_dy, self.shadow_blur, self.shadow_red, self.shadow_green, self.shadow_blue, self.shadow_opacity,
                      self.stroke_size, self.stroke_red, self.stroke_green, self.stroke_blue, self.stroke_opacity,
                      self.glow_size, self.glow_red, self.glow_green, self.glow_blue, self.glow_opacity]:
            mixed = (mixed ^ value.bits()) *% 0x100000001b3
        let flags: u64 = (1 if self.shadow else 0) | (2 if self.stroke else 0) | (4 if self.glow else 0)
        return (mixed ^ flags) *% 0x100000001b3

pub struct Layer:
    pub var id: u64
    pub var name: str
    pub var visible: bool = true
    pub var opacity: f64 = 1.0
    ## Photoshop's blend modes by number: 0 normal, 1 darken, 2 multiply, 3 color
    ## burn, 4 linear burn, 5 lighten, 6 screen, 7 color dodge, 8 linear dodge,
    ## 9 overlay, 10 soft light, 11 hard light, 12 vivid light, 13 linear light,
    ## 14 pin light, 15 hard mix, 16 difference, 17 exclusion, 18 subtract,
    ## 19 divide, 20 hue, 21 saturation, 22 color, 23 luminosity, 24 darker
    ## color, 25 lighter color.
    pub var blend: u32
    ## Take alpha from the nearest unclipped layer below, like Photoshop's
    ## clipping mask.
    pub var clipped: bool
    pub var group: bool
    pub var style: Style = Style()
    var pixels: Tiles*?
    ## The layer mask: red reveals, a missing tile reveals fully.
    var mask: Tiles*?
    var children: Layer*[]
    var child_count: usize
    ## Bumps whenever the pixels are replaced.
    pub var revision: u64

    ## The layer's tiles, borrowed; `none` for a group.
    pub func tiles() -> Tiles*?:
        return self.pixels

    ## The layer's mask tiles, borrowed; `none` without a mask.
    pub func mask_tiles() -> Tiles*?:
        return self.mask

    ## The children of a group, bottom to top.
    pub func layers() -> Layer*[]:
        return self.children[..<self.child_count]

    ## Replace the pixels outright (geometry changes), destroying the old ones.
    pub mutating func replace_tiles(tiles: Tiles) -> !:
        let holder = try box(tiles)
        if let previous = self.pixels:
            unbox(previous)
        self.pixels = holder
        self.revision += 1

    pub mutating func replace_mask(tiles: Tiles) -> !:
        let holder = try box(tiles)
        if let previous = self.mask:
            unbox(previous)
        self.mask = holder
        self.revision += 1

func layer_destroy(layer: Layer*):
    for child in layer.children[..<layer.child_count]:
        layer_destroy(child)
    if layer.children.length > 0:
        free(layer.children) in memory.heap
    if let tiles = layer.pixels:
        unbox(tiles)
    if let tiles = layer.mask:
        unbox(tiles)
    strings.release(layer.name)
    free(layer) in memory.heap

pub struct Document:
    var owner: gpu.Device
    var extent_x: u32
    var extent_y: u32
    ## The selection, part of the document so history can cover it.
    pub var selection: Selection
    var root: Layer*
    var next_id: u64
    ## Bumps whenever the tree changes shape or a layer's attributes change.
    pub var revision: u64

    ## An empty `width` by `height` document with no layers.
    pub static func create(device: gpu.Device, width: u32, height: u32) -> Document!:
        if width == 0 or height == 0 or width > 65536 or height > 65536:
            error(invalid, "document dimensions must be in 1..65536")
        var title: str = ""
        with memory.heap:
            title = try strings.copy("root")
        let root = try new Layer(id = 0, name = title, group = true, pixels = none, revision = 0) in memory.heap
        var selection = try Selection.create(width, height)
        errdefer selection.destroy()
        return Document(owner = device, extent_x = width, extent_y = height, selection = selection, root = root, next_id = 1, revision = 1)

    pub func width() -> u32:
        return self.extent_x

    pub func height() -> u32:
        return self.extent_y

    pub func device() -> gpu.Device:
        return self.owner

    ## The top-level layers, bottom to top.
    pub func layers() -> Layer*[]:
        return self.root.layers()

    ## The layer with `id`, borrowed.
    pub func find(id: u64) -> Layer*?:
        return find_in(self.root, id)

    ## Add a transparent raster layer on top of `parent` (the root by default).
    pub mutating func add_layer(name: str, parent: u64? = none) -> u64!:
        let tiles = try Tiles.create(self.owner, self.extent_x, self.extent_y)
        return try self.add(name, parent, false, tiles)

    ## Add an empty group on top of `parent` (the root by default).
    pub mutating func add_group(name: str, parent: u64? = none) -> u64!:
        return try self.add(name, parent, true, none)

    ## Give layer `id` a new name.
    pub mutating func rename(id: u64, name: str) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        var copied: str = ""
        with memory.heap:
            copied = try strings.copy(name)
        strings.release(layer.name)
        layer.name = copied

    mutating func add(name: str, parent: u64?, group: bool, tiles: Tiles?) -> u64!:
        var holder: Tiles*? = none
        if let owned = tiles:
            holder = try box(owned)
        errdefer release_tiles(&holder)
        var target = self.root
        if let id = parent:
            target = self.find(id) else error(invalid, "no such parent layer")
            if not target.group:
                error(invalid, "only a group can hold layers")
        if target.child_count == target.children.length:
            let capacity = 8 if target.children.length == 0 else target.children.length * 2
            let grown = try alloc Layer*[capacity] in memory.heap
            if target.child_count > 0:
                memory.copy(grown, target.children, target.child_count)
            if target.children.length > 0:
                free(target.children) in memory.heap
            target.children = grown
        var copied: str = ""
        with memory.heap:
            copied = try strings.copy(name)
        errdefer strings.release(copied)
        let id = self.next_id
        let layer = try new Layer(id = id, name = copied, group = group, pixels = holder, revision = 1) in memory.heap
        holder = none
        target.children[target.child_count] = layer
        target.child_count += 1
        self.next_id += 1
        self.revision += 1
        return id

    ## Move a layer one step up (`step` 1) or down (-1) among its siblings.
    pub mutating func reorder(id: u64, step: i64) -> !:
        let parent = parent_of(self.root, id) else error(invalid, "no such layer")
        var index: usize = 0
        while parent.children[index].id != id:
            index += 1
        let target = (i64)index + step
        if target < 0 or target >= (i64)parent.child_count:
            return
        let moved = parent.children[index]
        parent.children[index] = parent.children[(usize)target]
        parent.children[(usize)target] = moved
        self.revision += 1

    ## Copy a raster layer with its mask and appearance, placed just above it.
    pub mutating func duplicate(id: u64, name: str) -> u64!:
        let source = self.find(id) else error(invalid, "no such layer")
        if source.group:
            error(invalid, "groups cannot be duplicated yet")
        let tiles = source.tiles() else error(invalid, "no pixels to duplicate")
        var copy = try tiles.clone()
        errdefer copy.destroy()
        let parent = parent_of(self.root, id) else error(invalid, "no such layer")
        let created = try self.add(name, none if parent == self.root else parent.id, false, copy)
        let layer = self.find(created) else trap("just added")
        layer.visible = source.visible
        layer.opacity = source.opacity
        layer.blend = source.blend
        layer.clipped = source.clipped
        if let mask = source.mask_tiles():
            var mask_copy = try mask.clone()
            errdefer mask_copy.destroy()
            layer.mask = try box(mask_copy)
        # Place it right above the source.
        var origin: usize = 0
        while parent.children[origin].id != created:
            origin += 1
        var to: usize = 0
        while parent.children[to].id != id:
            to += 1
        let moved = parent.children[origin]
        var index = origin
        while index > to + 1:
            parent.children[index] = parent.children[index - 1]
            index -= 1
        parent.children[to + 1] = moved
        self.revision += 1
        return created

    ## The sibling directly below `id`, if any.
    pub func below(id: u64) -> Layer*?:
        let parent = parent_of(self.root, id) else return none
        var index: usize = 0
        while parent.children[index].id != id:
            index += 1
        if index == 0:
            return none
        return parent.children[index - 1]

    ## Remove a layer or a group with everything in it.
    pub mutating func remove(id: u64) -> !:
        if not remove_in(self.root, id):
            error(invalid, "no such layer")
        self.revision += 1

    ## Replace a raster layer's pixels, taking ownership of `tiles`.
    pub mutating func set_tiles(id: u64, tiles: Tiles) -> !:
        var holder: Tiles*? = try box(tiles)
        errdefer release_tiles(&holder)
        let layer = self.find(id) else error(invalid, "no such layer")
        if layer.group or tiles.width() != self.extent_x or tiles.height() != self.extent_y:
            error(invalid, "tiles must match a raster layer of the document's size")
        if let previous = layer.pixels:
            unbox(previous)
        layer.pixels = holder
        layer.revision += 1

    ## Replace a raster layer's pixels with `tiles` and hand back the pixels it
    ## had, for history.
    pub mutating func take_tiles(id: u64, tiles: Tiles) -> Tiles!:
        var holder: Tiles*? = try box(tiles)
        errdefer release_tiles(&holder)
        let layer = self.find(id) else error(invalid, "no such layer")
        let previous = layer.pixels else error(invalid, "a group has no pixels")
        if tiles.width() != self.extent_x or tiles.height() != self.extent_y:
            error(invalid, "tiles must match the document's size")
        layer.pixels = holder
        layer.revision += 1
        let taken = *previous
        free(previous) in memory.heap
        return taken

    ## Adopt new extents after every layer has been rebuilt for them.
    pub mutating func set_extent(width: u32, height: u32) -> !:
        self.extent_x = width
        self.extent_y = height
        var replacement = try Selection.create(width, height)
        self.selection.destroy()
        self.selection = replacement
        self.revision += 1

    ## The selection's GPU tiles, or none when nothing is selected.
    pub mutating func selection_tiles() -> Tiles*?!:
        return try self.selection.gpu_tiles(self.owner)

    ## Give a raster layer an empty mask (revealing everything) or take it away.
    pub mutating func set_mask(id: u64, present: bool) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        if layer.group:
            error(invalid, "a group cannot have a mask")
        if present and layer.mask == none:
            let tiles = try Tiles.create(self.owner, self.extent_x, self.extent_y)
            layer.mask = try box(tiles)
        elif not present:
            if let tiles = layer.mask:
                unbox(tiles)
            layer.mask = none
        layer.revision += 1
        self.revision += 1

    ## Replace a layer's mask with `tiles` and hand back the mask it had.
    pub mutating func take_mask(id: u64, tiles: Tiles) -> Tiles!:
        var holder: Tiles*? = try box(tiles)
        errdefer release_tiles(&holder)
        let layer = self.find(id) else error(invalid, "no such layer")
        let previous = layer.mask else error(invalid, "the layer has no mask")
        if tiles.width() != self.extent_x or tiles.height() != self.extent_y:
            error(invalid, "tiles must match the document's size")
        layer.mask = holder
        layer.revision += 1
        let taken = *previous
        free(previous) in memory.heap
        return taken

    ## Clip a layer to the one below, or unclip it.
    pub mutating func set_clipped(id: u64, clipped: bool) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        layer.clipped = clipped
        self.revision += 1

    ## Set a layer's visibility, opacity and blend mode.
    pub mutating func set_appearance(id: u64, visible: bool, opacity: f64, blend: u32 = 0) -> !:
        if not (opacity >= 0.0 and opacity <= 1.0):
            error(invalid, "opacity must be in 0..1")
        if blend > blend_mode_count - 1:
            error(invalid, "no such blend mode")
        let layer = self.find(id) else error(invalid, "no such layer")
        layer.visible = visible
        layer.opacity = opacity
        layer.blend = blend
        self.revision += 1

    pub mutating func destroy():
        self.selection.destroy()
        layer_destroy(self.root)

func release_tiles(holder: Tiles*?*):
    if let owned = *holder:
        unbox(owned)
        *holder = none

## Move a document onto the heap, for holders that keep a pointer.
pub func box_document(document: Document) -> Document*!:
    return try new Document(owner = document.owner, extent_x = document.extent_x, extent_y = document.extent_y, selection = document.selection,
                            root = document.root, next_id = document.next_id, revision = document.revision) in memory.heap

## Destroy a boxed document and free the box.
pub func unbox_document(document: Document*):
    document.destroy()
    free(document) in memory.heap

func parent_of(layer: Layer*, id: u64) -> Layer*?:
    for child in layer.children[..<layer.child_count]:
        if child.id == id:
            return layer
        if let found = parent_of(child, id):
            return found
    return none

func find_in(layer: Layer*, id: u64) -> Layer*?:
    for child in layer.children[..<layer.child_count]:
        if child.id == id:
            return child
        if let found = find_in(child, id):
            return found
    return none

func remove_in(layer: Layer*, id: u64) -> bool:
    for index in 0..<layer.child_count:
        let child = layer.children[index]
        if child.id == id:
            layer_destroy(child)
            for shift in index..<(layer.child_count - 1):
                layer.children[shift] = layer.children[shift + 1]
            layer.child_count -= 1
            return true
        if remove_in(child, id):
            return true
    return false

test "document layers, groups, removal and appearance":
    var device = gpu.Device.open() catch failure:
        assert(failure.code == gpu.unavailable)
        return
    defer device.destroy()
    var document = try Document.create(device, 64, 48)
    defer document.destroy()
    let background = try document.add_layer("Background")
    let group = try document.add_group("Group")
    let inner = try document.add_layer("Inner", group)
    assert(document.layers().length == 2 and document.layers()[1].id == group)
    let found = document.find(inner) else trap("missing layer")
    assert(found.name == "Inner" and found.tiles() != none and found.revision == 1)
    assert((document.find(group) else trap("missing group")).layers()[0].id == inner)
    try document.set_appearance(background, false, 0.5)
    assert(not (document.find(background) else trap("missing")).visible)
    var rejected = false
    discard(document.add_layer("Bad", inner) catch failure:
        assert(failure.code == invalid)
        rejected = true
        recover 0)
    assert(rejected)
    let replacement = try Tiles.create(device, 64, 48)
    try document.set_tiles(inner, replacement)
    assert(found.revision == 2)
    try document.remove(group)
    assert(document.find(inner) == none and document.layers().length == 1)
    let second = try document.add_layer("Second")
    try document.set_appearance(second, true, 0.5, 6)
    let copy = try document.duplicate(second, "Second copy")
    assert(document.layers().length == 3 and document.layers()[2].id == copy and (document.find(copy) else trap("copy")).blend == 6)
    try document.reorder(copy, -3)
    assert(document.layers()[2].id == copy)
    try document.reorder(copy, -1)
    assert(document.layers()[1].id == copy and document.layers()[2].id == second)
    assert((document.below(second) else trap("below")).id == copy and document.below(background) == none)
