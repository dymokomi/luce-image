## A layered document: a tree of layers over a canvas of fixed size, each
## raster layer holding shared GPU tiles in document space. Groups hold layers
## bottom to top and are pass-through: their opacity multiplies into their
## children and their visibility gates them. Editing replaces a layer's tiles;
## every replacement bumps revisions that the compositor keys its cache on.
import gpu
import math
import memory
import strings
from luce_image.tiles import Tiles, box, unbox
from luce_image.selection import Selection
from luce_image.curves import Curves
from raster_errors import invalid, limit

pub let blend_mode_count: u32 = 26

## A layer's styles, Photoshop's layer effects, kept with the layer; none is
## on by default. Drop shadow, outer glow and the stroke outside the edge are
## drawn under the layer's pixels; color overlay, inner shadow and the stroke
## inside the edge change the layer's own colors (its alpha kept), in
## Photoshop's order: overlay, inner shadow, stroke on top. Colors are linear
## light, 0..1; sizes and offsets in document pixels. Every setting is also a
## numbered field (`field`, `set_field`, `style_field_names`).
pub struct Style:
    pub var shadow: bool = false
    pub var shadow_dx: f64 = 4.0
    pub var shadow_dy: f64 = 4.0
    pub var shadow_blur: f64 = 4.0
    pub var shadow_red: f64 = 0.0
    pub var shadow_green: f64 = 0.0
    pub var shadow_blue: f64 = 0.0
    pub var shadow_opacity: f64 = 0.75
    pub var stroke: bool = false
    pub var stroke_size: f64 = 3.0
    pub var stroke_red: f64 = 0.0
    pub var stroke_green: f64 = 0.0
    pub var stroke_blue: f64 = 0.0
    pub var stroke_opacity: f64 = 1.0
    pub var glow: bool = false
    pub var glow_size: f64 = 8.0
    pub var glow_red: f64 = 1.0
    pub var glow_green: f64 = 1.0
    pub var glow_blue: f64 = 1.0
    pub var glow_opacity: f64 = 0.75
    ## Where the stroke runs: 0 outside the edge, 1 centered on it, 2 inside.
    pub var stroke_position: f64 = 0.0
    pub var overlay: bool = false
    pub var overlay_red: f64 = 1.0
    pub var overlay_green: f64 = 0.0
    pub var overlay_blue: f64 = 0.0
    pub var overlay_opacity: f64 = 1.0
    pub var inner: bool = false
    pub var inner_dx: f64 = 4.0
    pub var inner_dy: f64 = 4.0
    pub var inner_blur: f64 = 5.0
    pub var inner_red: f64 = 0.0
    pub var inner_green: f64 = 0.0
    pub var inner_blue: f64 = 0.0
    pub var inner_opacity: f64 = 0.75
    ## Inner glow: a color spreading inward from the edge, `inner_glow_size` pixels.
    pub var inner_glow: bool = false
    pub var inner_glow_size: f64 = 8.0
    pub var inner_glow_red: f64 = 1.0
    pub var inner_glow_green: f64 = 1.0
    pub var inner_glow_blue: f64 = 0.75
    pub var inner_glow_opacity: f64 = 0.75

    ## Whether any effect is on.
    pub func any() -> bool:
        return self.shadow or self.stroke or self.glow or self.overlay or self.inner or self.inner_glow

    ## Whether an effect goes under the layer's pixels.
    pub func under() -> bool:
        return self.shadow or self.glow or (self.stroke and self.stroke_position < 1.5)

    ## Whether an effect changes the layer's own colors.
    pub func over() -> bool:
        return self.overlay or self.inner or self.inner_glow or (self.stroke and self.stroke_position > 0.5)

    ## A digest of every setting, for caches.
    pub func digest() -> u64:
        var mixed = fnv_start()
        var index: i64 = 0
        while index < style_field_count:
            mixed = fnv_mix(mixed, (self.field(index) else 0.0).bits())
            index += 1
        return mixed

    ## Setting `index` (see `style_field_names`) as a number; switches are 0 or 1.
    pub func field(index: i64) -> f64?:
        if index == 0: return 1.0 if self.shadow else 0.0
        if index == 1: return self.shadow_dx
        if index == 2: return self.shadow_dy
        if index == 3: return self.shadow_blur
        if index == 4: return self.shadow_red
        if index == 5: return self.shadow_green
        if index == 6: return self.shadow_blue
        if index == 7: return self.shadow_opacity
        if index == 8: return 1.0 if self.stroke else 0.0
        if index == 9: return self.stroke_size
        if index == 10: return self.stroke_red
        if index == 11: return self.stroke_green
        if index == 12: return self.stroke_blue
        if index == 13: return self.stroke_opacity
        if index == 14: return 1.0 if self.glow else 0.0
        if index == 15: return self.glow_size
        if index == 16: return self.glow_red
        if index == 17: return self.glow_green
        if index == 18: return self.glow_blue
        if index == 19: return self.glow_opacity
        if index == 20: return self.stroke_position
        if index == 21: return 1.0 if self.overlay else 0.0
        if index == 22: return self.overlay_red
        if index == 23: return self.overlay_green
        if index == 24: return self.overlay_blue
        if index == 25: return self.overlay_opacity
        if index == 26: return 1.0 if self.inner else 0.0
        if index == 27: return self.inner_dx
        if index == 28: return self.inner_dy
        if index == 29: return self.inner_blur
        if index == 30: return self.inner_red
        if index == 31: return self.inner_green
        if index == 32: return self.inner_blue
        if index == 33: return self.inner_opacity
        if index == 34: return 1.0 if self.inner_glow else 0.0
        if index == 35: return self.inner_glow_size
        if index == 36: return self.inner_glow_red
        if index == 37: return self.inner_glow_green
        if index == 38: return self.inner_glow_blue
        if index == 39: return self.inner_glow_opacity
        return none

    ## Set setting `index` from a number, checked: switches take non-zero as
    ## on, colors and opacities 0..1, sizes and blurs 0..250, offsets -1000..1000.
    pub mutating func set_field(index: i64, value: f64) -> !:
        if not math.is_finite(value):
            error(invalid, "style settings must be finite")
        let kind = field_kind(index)
        if kind == 0:
            error(invalid, "style fields are 0..39")
        if kind == 2 and (value < 0.0 or value > 1.0):
            error(invalid, "style colors and opacities are 0..1")
        if kind == 3 and (value < 0.0 or value > 250.0):
            error(invalid, "style sizes are 0..250 pixels")
        if kind == 4 and (value < -1000.0 or value > 1000.0):
            error(invalid, "style offsets are -1000..1000 pixels")
        if kind == 5 and value != 0.0 and value != 1.0 and value != 2.0:
            error(invalid, "a stroke runs outside (0), centered (1) or inside (2)")
        let on = value != 0.0
        if index == 0: self.shadow = on
        elif index == 1: self.shadow_dx = value
        elif index == 2: self.shadow_dy = value
        elif index == 3: self.shadow_blur = value
        elif index == 4: self.shadow_red = value
        elif index == 5: self.shadow_green = value
        elif index == 6: self.shadow_blue = value
        elif index == 7: self.shadow_opacity = value
        elif index == 8: self.stroke = on
        elif index == 9: self.stroke_size = value
        elif index == 10: self.stroke_red = value
        elif index == 11: self.stroke_green = value
        elif index == 12: self.stroke_blue = value
        elif index == 13: self.stroke_opacity = value
        elif index == 14: self.glow = on
        elif index == 15: self.glow_size = value
        elif index == 16: self.glow_red = value
        elif index == 17: self.glow_green = value
        elif index == 18: self.glow_blue = value
        elif index == 19: self.glow_opacity = value
        elif index == 20: self.stroke_position = value
        elif index == 21: self.overlay = on
        elif index == 22: self.overlay_red = value
        elif index == 23: self.overlay_green = value
        elif index == 24: self.overlay_blue = value
        elif index == 25: self.overlay_opacity = value
        elif index == 26: self.inner = on
        elif index == 27: self.inner_dx = value
        elif index == 28: self.inner_dy = value
        elif index == 29: self.inner_blur = value
        elif index == 30: self.inner_red = value
        elif index == 31: self.inner_green = value
        elif index == 32: self.inner_blue = value
        elif index == 33: self.inner_opacity = value
        elif index == 34: self.inner_glow = on
        elif index == 35: self.inner_glow_size = value
        elif index == 36: self.inner_glow_red = value
        elif index == 37: self.inner_glow_green = value
        elif index == 38: self.inner_glow_blue = value
        else: self.inner_glow_opacity = value

## How many numbered style settings there are.
pub let style_field_count: i64 = 40

## The settings' names, in field order, as documents keep them.
pub func style_field_names() -> str[40]:
    return ["shadow", "shadow_dx", "shadow_dy", "shadow_blur", "shadow_red", "shadow_green", "shadow_blue", "shadow_opacity",
            "stroke", "stroke_size", "stroke_red", "stroke_green", "stroke_blue", "stroke_opacity",
            "glow", "glow_size", "glow_red", "glow_green", "glow_blue", "glow_opacity", "stroke_position",
            "overlay", "overlay_red", "overlay_green", "overlay_blue", "overlay_opacity",
            "inner", "inner_dx", "inner_dy", "inner_blur", "inner_red", "inner_green", "inner_blue", "inner_opacity",
            "inner_glow", "inner_glow_size", "inner_glow_red", "inner_glow_green", "inner_glow_blue", "inner_glow_opacity"]

## What a field holds: 1 a switch, 2 a color or opacity, 3 a size, 4 an
## offset, 5 the stroke's position; 0 no such field.
func field_kind(index: i64) -> i64:
    if index == 0 or index == 8 or index == 14 or index == 21 or index == 26 or index == 34:
        return 1
    if index == 1 or index == 2 or index == 27 or index == 28:
        return 4
    if index == 3 or index == 9 or index == 15 or index == 29 or index == 35:
        return 3
    if index == 20:
        return 5
    if index > 0 and index < style_field_count:
        return 2
    return 0

pub struct Layer:
    pub var id: u64
    pub var name: str
    pub var visible: bool = true
    pub var opacity: f64 = 1.0
    ## Photoshop's blend modes by number: 0 normal, 1 darken, 2 multiply, 3 color
    ## burn, 4 linear burn, 5 lighten, 6 screen, 7 color dodge, 8 linear dodge,
    ## 9 overlay, 10 soft light, 11 hard light, 12 vivid light, 13 linear light,
    ## 14 pin light, 15 hard mix, 16 difference, 17 exclusion, 18 subtract,
    ## 19 divide, 20 hue, 21 saturation, 22 color, 23 luminosity, 24 darker
    ## color, 25 lighter color.
    pub var blend: u32
    ## Take alpha from the nearest unclipped layer below, like Photoshop's
    ## clipping mask.
    pub var clipped: bool
    pub var group: bool
    pub var style: Style = Style()
    var pixels: Tiles*?
    ## The layer mask: red reveals, a missing tile reveals fully.
    var mask: Tiles*?
    ## A disabled mask is kept but hides nothing, as Photoshop's Shift-click.
    pub var mask_enabled: bool = true
    ## An adjustment layer's kind (adjust.lucb's numbers) and parameters, or -1:
    ## it has no pixels and adjusts what is below it, live, through its mask.
    pub var adjustment: i64 = -1
    pub var adjustment_values: f64[23]
    ## A Curves adjustment layer's curves (no points: values pass through).
    pub var curves: Curves
    var children: Layer*[]
    var child_count: usize
    ## Bumps whenever the pixels are replaced.
    pub var revision: u64

    ## The layer's tiles, borrowed; `none` for a group.
    pub func tiles() -> Tiles*?:
        return self.pixels

    ## The layer's mask tiles, borrowed; `none` without a mask.
    pub func mask_tiles() -> Tiles*?:
        return self.mask

    ## The mask as it hides pixels: `none` without one or while it is disabled.
    ## What an edit works on: the pixels, or with `mask` the mask.
    pub func edited_tiles(mask: bool) -> Tiles*!:
        if mask:
            return self.mask_tiles() else error(invalid, "the layer has no mask")
        return self.tiles() else error(invalid, "a group has no pixels of its own")

    pub func active_mask() -> Tiles*?:
        return self.mask if self.mask_enabled else none

    ## The children of a group, bottom to top.
    pub func layers() -> Layer*[]:
        return self.children[..<self.child_count]

    ## Replace the pixels outright (geometry changes), destroying the old ones.
    pub mutating func replace_tiles(tiles: Tiles) -> !:
        let holder = try box(tiles)
        if let previous = self.pixels:
            unbox(previous)
        self.pixels = holder
        self.revision += 1

    pub mutating func replace_mask(tiles: Tiles) -> !:
        let holder = try box(tiles)
        if let previous = self.mask:
            unbox(previous)
        self.mask = holder
        self.revision += 1

## `layer` and all it holds given revisions in band `generation`, clear of
## every revision an earlier band handed out.
func restamp(layer: Layer*, generation: u64):
    layer.revision = (generation << 40) | (layer.revision & 0xFFFFFFFFFF)
    for child in layer.children[..<layer.child_count]:
        restamp(child, generation)

func layer_destroy(layer: Layer*):
    for child in layer.children[..<layer.child_count]:
        layer_destroy(child)
    if layer.children.length > 0:
        free(layer.children) in memory.heap
    if let tiles = layer.pixels:
        unbox(tiles)
    if let tiles = layer.mask:
        unbox(tiles)
    strings.release(layer.name)
    free(layer) in memory.heap

## The layer tree, extent and selection at one moment, for undo: a copy of
## the tree sharing its tiles, so taking one costs little.
pub struct TreeState:
    var root: Layer*
    var next_id: u64
    var extent_x: u32
    var extent_y: u32
    var selection: Selection

    pub mutating func destroy():
        layer_destroy(self.root)
        self.selection.destroy()

## A copy of `layer` and all it holds, sharing their tiles.
func clone_layer(layer: const Layer*) -> Layer*!:
    var copied: str = ""
    with memory.heap:
        copied = try strings.copy(layer.name)
    errdefer strings.release(copied)
    var pixels: Tiles*? = none
    if let tiles = layer.pixels:
        pixels = try box(try tiles.clone())
    errdefer release_tiles(&pixels)
    let copy = try new Layer(id = layer.id, name = copied, group = layer.group, pixels = pixels, revision = layer.revision) in memory.heap
    errdefer layer_destroy(copy)
    copy.visible = layer.visible
    copy.opacity = layer.opacity
    copy.blend = layer.blend
    copy.clipped = layer.clipped
    copy.style = layer.style
    copy.mask_enabled = layer.mask_enabled
    copy.adjustment = layer.adjustment
    copy.adjustment_values = layer.adjustment_values
    copy.curves = layer.curves
    if let mask = layer.mask:
        copy.mask = try box(try mask.clone())
    if layer.child_count > 0:
        copy.children = try alloc Layer*[layer.child_count] in memory.heap
        for index in 0..<layer.child_count:
            copy.children[index] = try clone_layer(layer.children[index])
            copy.child_count += 1
    return copy

pub struct Document:
    var owner: gpu.Device
    var extent_x: u32
    var extent_y: u32
    ## The selection, part of the document so history can cover it.
    pub var selection: Selection
    var root: Layer*
    var next_id: u64
    ## Bumps whenever the tree changes shape or a layer's attributes change.
    pub var revision: u64
    ## How many times history has swapped the tree: each swap moves every
    ## layer's revision into a band of its own (see `exchange`).
    var generation: u64

    ## An empty `width` by `height` document with no layers.
    pub static func create(device: gpu.Device, width: u32, height: u32) -> Document!:
        if width == 0 or height == 0 or width > 65536 or height > 65536:
            error(invalid, "document dimensions must be in 1..65536")
        var title: str = ""
        with memory.heap:
            title = try strings.copy("root")
        let root = try new Layer(id = 0, name = title, group = true, pixels = none, revision = 0) in memory.heap
        var selection = try Selection.create(width, height)
        errdefer selection.destroy()
        return Document(owner = device, extent_x = width, extent_y = height, selection = selection, root = root, next_id = 1, revision = 1, generation = 0)

    pub func width() -> u32:
        return self.extent_x

    pub func height() -> u32:
        return self.extent_y

    pub func device() -> gpu.Device:
        return self.owner

    ## The top-level layers, bottom to top.
    pub func layers() -> Layer*[]:
        return self.root.layers()

    ## The layer with `id`, borrowed.
    pub func find(id: u64) -> Layer*?:
        return find_in(self.root, id)

    ## Add a transparent raster layer on top of `parent` (the root by default).
    pub mutating func add_layer(name: str, parent: u64? = none) -> u64!:
        let tiles = try Tiles.create(self.owner, self.extent_x, self.extent_y)
        return try self.add(name, parent, false, tiles)

    ## Add an adjustment layer of `kind` with `values` (at most 23) on top of
    ## `parent` (the root by default).
    pub mutating func add_adjustment(name: str, kind: i64, values: const f64[], parent: u64? = none) -> u64!:
        let id = try self.add(name, parent, false, none)
        try self.set_adjustment(id, kind, values)
        return id

    ## Give Curves adjustment layer `id` its curves anew.
    pub mutating func set_curves(id: u64, curves: Curves) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        if layer.adjustment < 0:
            error(invalid, "only an adjustment layer takes curves")
        layer.curves = curves
        layer.revision += 1
        self.revision += 1

    ## Give adjustment layer `id` its kind and parameters anew.
    pub mutating func set_adjustment(id: u64, kind: i64, values: const f64[]) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        if layer.group or layer.pixels != none:
            error(invalid, "only an adjustment layer takes adjustment settings")
        if values.length > 23:
            error(invalid, "an adjustment takes at most 23 parameters")
        layer.adjustment = kind
        for index in 0..<(usize)23:
            layer.adjustment_values[index] = values[index] if index < values.length else 0.0
        layer.revision += 1
        self.revision += 1

    ## Add an empty group on top of `parent` (the root by default).
    pub mutating func add_group(name: str, parent: u64? = none) -> u64!:
        return try self.add(name, parent, true, none)

    ## Give layer `id` a new name.
    pub mutating func rename(id: u64, name: str) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        var copied: str = ""
        with memory.heap:
            copied = try strings.copy(name)
        strings.release(layer.name)
        layer.name = copied

    mutating func add(name: str, parent: u64?, group: bool, tiles: Tiles?) -> u64!:
        var holder: Tiles*? = none
        if let owned = tiles:
            holder = try box(owned)
        errdefer release_tiles(&holder)
        var target = self.root
        if let id = parent:
            target = self.find(id) else error(invalid, "no such parent layer")
            if not target.group:
                error(invalid, "only a group can hold layers")
        try make_room(target)
        var copied: str = ""
        with memory.heap:
            copied = try strings.copy(name)
        errdefer strings.release(copied)
        let id = self.next_id
        let layer = try new Layer(id = id, name = copied, group = group, pixels = holder, revision = 1) in memory.heap
        holder = none
        target.children[target.child_count] = layer
        target.child_count += 1
        self.next_id += 1
        self.revision += 1
        return id

    ## Move a layer — a group with everything in it — into group `parent` (the
    ## top level when none) at `position` among its layers, 0 the bottom; past
    ## the top it goes on top. A group cannot go inside itself.
    pub mutating func move_to(id: u64, parent: u64?, position: usize) -> !:
        let moving = self.find(id) else error(invalid, "no such layer")
        var target = self.root
        if let parent_id = parent:
            target = self.find(parent_id) else error(invalid, "no such parent layer")
            if not target.group:
                error(invalid, "only a group can hold layers")
            if parent_id == id or find_in(moving, parent_id) != none:
                error(invalid, "a group cannot go inside itself")
        # Room first, so a failed allocation leaves the tree as it was.
        try make_room(target)
        let source = parent_of(self.root, id) else error(invalid, "no such layer")
        var index: usize = 0
        while source.children[index].id != id:
            index += 1
        for shift in index..<(source.child_count - 1):
            source.children[shift] = source.children[shift + 1]
        source.child_count -= 1
        let at = position if position < target.child_count else target.child_count
        var shift = target.child_count
        while shift > at:
            target.children[shift] = target.children[shift - 1]
            shift -= 1
        target.children[at] = moving
        target.child_count += 1
        self.revision += 1

    ## The group holding `id`, or none at the top level.
    pub func parent_id(id: u64) -> u64?:
        let parent = parent_of(self.root, id) else return none
        return none if parent == self.root else parent.id

    ## Where `id` sits among its parent's layers, 0 the bottom.
    pub func position(id: u64) -> usize!:
        let parent = parent_of(self.root, id) else error(invalid, "no such layer")
        var index: usize = 0
        while parent.children[index].id != id:
            index += 1
        return index

    ## Keep a layer's mask but stop it hiding anything, or bring it back.
    pub mutating func enable_mask(id: u64, enabled: bool) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        layer.mask_enabled = enabled
        layer.revision += 1
        self.revision += 1

    ## Move a layer one step up (`step` 1) or down (-1) among its siblings.
    pub mutating func reorder(id: u64, step: i64) -> !:
        let parent = parent_of(self.root, id) else error(invalid, "no such layer")
        var index: usize = 0
        while parent.children[index].id != id:
            index += 1
        let target = (i64)index + step
        if target < 0 or target >= (i64)parent.child_count:
            return
        let moved = parent.children[index]
        parent.children[index] = parent.children[(usize)target]
        parent.children[(usize)target] = moved
        self.revision += 1

    ## Copy a raster layer with its mask and appearance, placed just above it.
    pub mutating func duplicate(id: u64, name: str) -> u64!:
        let source = self.find(id) else error(invalid, "no such layer")
        if source.group:
            error(invalid, "groups cannot be duplicated yet")
        let tiles = source.tiles() else error(invalid, "no pixels to duplicate")
        var copy = try tiles.clone()
        errdefer copy.destroy()
        let parent = parent_of(self.root, id) else error(invalid, "no such layer")
        let created = try self.add(name, none if parent == self.root else parent.id, false, copy)
        let layer = self.find(created) else trap("just added")
        layer.visible = source.visible
        layer.opacity = source.opacity
        layer.blend = source.blend
        layer.clipped = source.clipped
        if let mask = source.mask_tiles():
            var mask_copy = try mask.clone()
            errdefer mask_copy.destroy()
            layer.mask = try box(mask_copy)
        # Place it right above the source.
        var origin: usize = 0
        while parent.children[origin].id != created:
            origin += 1
        var to: usize = 0
        while parent.children[to].id != id:
            to += 1
        let moved = parent.children[origin]
        var index = origin
        while index > to + 1:
            parent.children[index] = parent.children[index - 1]
            index -= 1
        parent.children[to + 1] = moved
        self.revision += 1
        return created

    ## The sibling directly below `id`, if any.
    pub func below(id: u64) -> Layer*?:
        let parent = parent_of(self.root, id) else return none
        var index: usize = 0
        while parent.children[index].id != id:
            index += 1
        if index == 0:
            return none
        return parent.children[index - 1]

    ## Remove a layer or a group with everything in it.
    pub mutating func remove(id: u64) -> !:
        if not remove_in(self.root, id):
            error(invalid, "no such layer")
        self.revision += 1

    ## Replace a raster layer's pixels, taking ownership of `tiles`.
    pub mutating func set_tiles(id: u64, tiles: Tiles) -> !:
        var holder: Tiles*? = try box(tiles)
        errdefer release_tiles(&holder)
        let layer = self.find(id) else error(invalid, "no such layer")
        if layer.group or tiles.width() != self.extent_x or tiles.height() != self.extent_y:
            error(invalid, "tiles must match a raster layer of the document's size")
        if let previous = layer.pixels:
            unbox(previous)
        layer.pixels = holder
        layer.revision += 1

    ## Replace a raster layer's pixels with `tiles` and hand back the pixels it
    ## had, for history.
    pub mutating func take_tiles(id: u64, tiles: Tiles) -> Tiles!:
        var holder: Tiles*? = try box(tiles)
        errdefer release_tiles(&holder)
        let layer = self.find(id) else error(invalid, "no such layer")
        let previous = layer.pixels else error(invalid, "a group has no pixels")
        if tiles.width() != self.extent_x or tiles.height() != self.extent_y:
            error(invalid, "tiles must match the document's size")
        layer.pixels = holder
        layer.revision += 1
        let taken = *previous
        free(previous) in memory.heap
        return taken

    ## Adopt new extents after every layer has been rebuilt for them.
    ## The tree, extent and selection as they are, for undo.
    pub func capture() -> TreeState!:
        let root = try clone_layer(self.root)
        errdefer layer_destroy(root)
        return TreeState(root = root, next_id = self.next_id, extent_x = self.extent_x, extent_y = self.extent_y, selection = try self.selection.copy())

    ## Take `state` as the document and leave what was in its place: undo and
    ## redo swap, never copy.
    pub mutating func exchange(state: TreeState*):
        let root = self.root
        self.root = state.root
        state.root = root
        let next_id = self.next_id
        self.next_id = state.next_id
        state.next_id = next_id
        let width = self.extent_x
        self.extent_x = state.extent_x
        state.extent_x = width
        let height = self.extent_y
        self.extent_y = state.extent_y
        state.extent_y = height
        let selection = self.selection
        self.selection = state.selection
        state.selection = selection
        self.revision += 1
        # The layers coming back carry the revisions they had when taken, and
        # counting on from there would reach numbers the compositor's cache
        # holds for other pixels: move them into a band of their own.
        self.generation += 1
        restamp(self.root, self.generation)

    pub mutating func set_extent(width: u32, height: u32) -> !:
        self.extent_x = width
        self.extent_y = height
        var replacement = try Selection.create(width, height)
        self.selection.destroy()
        self.selection = replacement
        self.revision += 1

    ## The selection's GPU tiles, or none when nothing is selected.
    pub mutating func selection_tiles() -> Tiles*?!:
        return try self.selection.gpu_tiles(self.owner)

    ## Give a layer or a group an empty mask (revealing everything) or take it away.
    pub mutating func set_mask(id: u64, present: bool) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        if present and layer.mask == none:
            let tiles = try Tiles.create(self.owner, self.extent_x, self.extent_y)
            layer.mask = try box(tiles)
        elif not present:
            if let tiles = layer.mask:
                unbox(tiles)
            layer.mask = none
        layer.revision += 1
        self.revision += 1

    ## Replace a layer's mask with `tiles` and hand back the mask it had.
    pub mutating func take_mask(id: u64, tiles: Tiles) -> Tiles!:
        var holder: Tiles*? = try box(tiles)
        errdefer release_tiles(&holder)
        let layer = self.find(id) else error(invalid, "no such layer")
        let previous = layer.mask else error(invalid, "the layer has no mask")
        if tiles.width() != self.extent_x or tiles.height() != self.extent_y:
            error(invalid, "tiles must match the document's size")
        layer.mask = holder
        layer.revision += 1
        let taken = *previous
        free(previous) in memory.heap
        return taken

    ## Clip a layer to the one below, or unclip it.
    pub mutating func set_clipped(id: u64, clipped: bool) -> !:
        let layer = self.find(id) else error(invalid, "no such layer")
        layer.clipped = clipped
        self.revision += 1

    ## Set a layer's visibility, opacity and blend mode.
    pub mutating func set_appearance(id: u64, visible: bool, opacity: f64, blend: u32 = 0) -> !:
        if not (opacity >= 0.0 and opacity <= 1.0):
            error(invalid, "opacity must be in 0..1")
        if blend > blend_mode_count - 1:
            error(invalid, "no such blend mode")
        let layer = self.find(id) else error(invalid, "no such layer")
        layer.visible = visible
        layer.opacity = opacity
        layer.blend = blend
        self.revision += 1

    pub mutating func destroy():
        self.selection.destroy()
        layer_destroy(self.root)

func release_tiles(holder: Tiles*?*):
    if let owned = *holder:
        unbox(owned)
        *holder = none

## Move a document onto the heap, for holders that keep a pointer.
pub func box_document(document: Document) -> Document*!:
    # Not zeroable, so field by field: a new field must be added here too.
    return try new Document(owner = document.owner, extent_x = document.extent_x, extent_y = document.extent_y, selection = document.selection,
                            root = document.root, next_id = document.next_id, revision = document.revision, generation = document.generation) in memory.heap

## Destroy a boxed document and free the box.
pub func unbox_document(document: Document*):
    document.destroy()
    free(document) in memory.heap

## Grow a group's children so one more fits.
func make_room(layer: Layer*) -> !:
    if layer.child_count < layer.children.length:
        return
    let capacity = 8 if layer.children.length == 0 else layer.children.length * 2
    let grown = try alloc Layer*[capacity] in memory.heap
    if layer.child_count > 0:
        memory.copy(grown, layer.children, layer.child_count)
    if layer.children.length > 0:
        free(layer.children) in memory.heap
    layer.children = grown

func parent_of(layer: Layer*, id: u64) -> Layer*?:
    for child in layer.children[..<layer.child_count]:
        if child.id == id:
            return layer
        if let found = parent_of(child, id):
            return found
    return none

func find_in(layer: Layer*, id: u64) -> Layer*?:
    for child in layer.children[..<layer.child_count]:
        if child.id == id:
            return child
        if let found = find_in(child, id):
            return found
    return none

func remove_in(layer: Layer*, id: u64) -> bool:
    for index in 0..<layer.child_count:
        let child = layer.children[index]
        if child.id == id:
            layer_destroy(child)
            for shift in index..<(layer.child_count - 1):
                layer.children[shift] = layer.children[shift + 1]
            layer.child_count -= 1
            return true
        if remove_in(child, id):
            return true
    return false

## FNV-1a over 64-bit words, byte by byte: the digests the compositor's caches key on.
pub func fnv_start() -> u64:
    return 14695981039346656037

pub func fnv_mix(digest: u64, value: u64) -> u64:
    var mixed = digest
    for shift in 0..<(u64)8:
        mixed = (mixed ^ ((value >> (shift * 8)) & 0xff)) *% 1099511628211
    return mixed

test "document layers, groups, removal and appearance":
    var device = gpu.Device.open() catch failure:
        assert(failure.code == gpu.unavailable)
        return
    defer device.destroy()
    var document = try Document.create(device, 64, 48)
    defer document.destroy()
    let background = try document.add_layer("Background")
    let group = try document.add_group("Group")
    let inner = try document.add_layer("Inner", group)
    assert(document.layers().length == 2 and document.layers()[1].id == group)
    let found = document.find(inner) else trap("missing layer")
    assert(found.name == "Inner" and found.tiles() != none and found.revision == 1)
    assert((document.find(group) else trap("missing group")).layers()[0].id == inner)
    try document.set_appearance(background, false, 0.5)
    assert(not (document.find(background) else trap("missing")).visible)
    var rejected = false
    discard(document.add_layer("Bad", inner) catch failure:
        assert(failure.code == invalid)
        rejected = true
        recover 0)
    assert(rejected)
    let replacement = try Tiles.create(device, 64, 48)
    try document.set_tiles(inner, replacement)
    assert(found.revision == 2)
    try document.remove(group)
    assert(document.find(inner) == none and document.layers().length == 1)
    let second = try document.add_layer("Second")
    try document.set_appearance(second, true, 0.5, 6)
    let copy = try document.duplicate(second, "Second copy")
    assert(document.layers().length == 3 and document.layers()[2].id == copy and (document.find(copy) else trap("copy")).blend == 6)
    try document.reorder(copy, -3)
    assert(document.layers()[2].id == copy)
    try document.reorder(copy, -1)
    assert(document.layers()[1].id == copy and document.layers()[2].id == second)
    assert((document.below(second) else trap("below")).id == copy and document.below(background) == none)
