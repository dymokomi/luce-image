## Document-wide geometry, destructive: changing the canvas size (with the
## existing pixels anchored at an offset, so cropping is a canvas size with a
## negative offset) and resampling the whole image to a new size. Every raster
## layer and mask is rebuilt tile by tile on the GPU.
import gpu
import interop
import math
import memory
from luce_image.tiles import Tiles, tile_size, box, unbox
from luce_image.document import Document, Layer
from luce_image.errors import invalid

## `tiles` drawn into a `width` by `height` layer with its pixels scaled by
## (`scale_x`, `scale_y`) and its origin at (`offset_x`, `offset_y`).
func rebuilt(device: gpu.Device, tiles: Tiles*, width: u32, height: u32, scale_x: f64, scale_y: f64, offset_x: f64, offset_y: f64, smooth: bool) -> Tiles!:
    var fresh = try Tiles.create(device, width, height)
    errdefer fresh.destroy()
    for row in 0..<fresh.rows():
        for column in 0..<fresh.columns():
            let left = (f64)(column * tile_size)
            let top = (f64)(row * tile_size)
            var texture = gpu.Texture()
            var opened = false
            var drew = false
            var holder: interop.Reference[gpu.Frame]? = none
            for source_row in 0..<tiles.rows():
                for source_column in 0..<tiles.columns():
                    let area = tiles.region(source_column, source_row)
                    # Where this source tile lands in the new layer, in new pixels.
                    let x = offset_x + (f64)(source_column * tile_size) * scale_x - left
                    let y = offset_y + (f64)(source_row * tile_size) * scale_y - top
                    let w = (f64)area.width * scale_x
                    let h = (f64)area.height * scale_y
                    if x >= (f64)tile_size or y >= (f64)tile_size or x + w <= 0.0 or y + h <= 0.0:
                        continue
                    let source = tiles.texture(source_column, source_row) else continue
                    if not opened:
                        texture = try fresh.blank()
                        opened = true
                    let frame = holder else try texture.frame()
                    holder = frame
                    let target = try frame.value().target()
                    defer target.release()
                    try gpu.draw_image(target.value(), source, gpu.Rect(x, y, w, h), area, 1.0, gpu.Filter.linear if smooth else gpu.Filter.nearest)
                    drew = true
            if let frame = holder:
                discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))
                frame.release()
            if drew:
                try fresh.set(column, row, texture)
            elif opened:
                texture.destroy()
    return fresh

func rebuild_layers(device: gpu.Device, layers: Layer*[], width: u32, height: u32, scale_x: f64, scale_y: f64, offset_x: f64, offset_y: f64, smooth: bool) -> !:
    for layer in layers:
        if layer.group:
            try rebuild_layers(device, layer.layers(), width, height, scale_x, scale_y, offset_x, offset_y, smooth)
            continue
        if let tiles = layer.tiles():
            let replaced = try rebuilt(device, tiles, width, height, scale_x, scale_y, offset_x, offset_y, smooth)
            try layer.replace_tiles(replaced)
        if let mask = layer.mask_tiles():
            let replaced = try rebuilt(device, mask, width, height, scale_x, scale_y, offset_x, offset_y, smooth)
            try layer.replace_mask(replaced)

## Change the canvas to `width` by `height`, keeping the existing pixels with
## their top-left at (`offset_x`, `offset_y`) in the new canvas.
pub func resize_canvas(document: Document*, width: u32, height: u32, offset_x: i64, offset_y: i64) -> !:
    if width == 0 or height == 0 or width > 65536 or height > 65536:
        error(invalid, "canvas dimensions must be in 1..65536")
    try rebuild_layers(document.device(), document.layers(), width, height, 1.0, 1.0, (f64)offset_x, (f64)offset_y, false)
    document.set_extent(width, height)

## Resample the whole image to `width` by `height`.
pub func resize_image(document: Document*, width: u32, height: u32) -> !:
    if width == 0 or height == 0 or width > 65536 or height > 65536:
        error(invalid, "image dimensions must be in 1..65536")
    let scale_x = (f64)width / (f64)document.width()
    let scale_y = (f64)height / (f64)document.height()
    try rebuild_layers(document.device(), document.layers(), width, height, scale_x, scale_y, 0.0, 0.0, true)
    document.set_extent(width, height)

test "canvas and image resizing keep pixels in place and scale them":
    var device = gpu.Device.open() catch failure:
        assert(failure.code == gpu.unavailable)
        return
    defer device.destroy()
    var document = try Document.create(device, 300, 40)
    defer document.destroy()
    let layer = try document.add_layer("Dot")
    let count = (usize)300 * 40 * 4
    let pixels = try alloc f32[count] in memory.heap
    defer free(pixels) in memory.heap
    for index in 0..<count:
        pixels[index] = 0.0
    pixels[(10 * 300 + 260) * 4 + 1] = 1.0
    pixels[(10 * 300 + 260) * 4 + 3] = 1.0
    var tiles = try Tiles.create(device, 300, 40)
    try tiles.write(pixels)
    try document.set_tiles(layer, tiles)
    # Crop to x 250..300, y 0..40: the dot lands at (10, 10).
    try resize_canvas(&document, 50, 40, -250, 0)
    assert(document.width() == 50 and document.height() == 40)
    let cropped = try alloc f32[(usize)50 * 40 * 4] in memory.heap
    defer free(cropped) in memory.heap
    try ((document.find(layer) else trap("layer")).tiles() else trap("tiles")).read(cropped)
    assert(cropped[(10 * 50 + 10) * 4 + 1] > 0.99)
    # Grow to 100 x 80 with the old canvas at (20, 20): the dot is at (30, 30).
    try resize_canvas(&document, 100, 80, 20, 20)
    let grown = try alloc f32[(usize)100 * 80 * 4] in memory.heap
    defer free(grown) in memory.heap
    try ((document.find(layer) else trap("layer")).tiles() else trap("tiles")).read(grown)
    assert(grown[(30 * 100 + 30) * 4 + 1] > 0.99 and grown[(10 * 100 + 10) * 4 + 3] == 0.0)
    # Double the image: the dot spreads around (60, 60).
    try resize_image(&document, 200, 160)
    let doubled = try alloc f32[(usize)200 * 160 * 4] in memory.heap
    defer free(doubled) in memory.heap
    try ((document.find(layer) else trap("layer")).tiles() else trap("tiles")).read(doubled)
    assert(doubled[(60 * 200 + 60) * 4 + 3] > 0.2 and doubled[(30 * 200 + 30) * 4 + 3] == 0.0)
