## Content-Aware Fill, after Photoshop's: the hole filled with texture taken
## from around it, patch by patch, as Criminisi, Pérez and Toyama's
## exemplar-based inpainting does. The hole is filled from its edge inward;
## the next patch filled is the one on the edge that is most known and sits
## on the strongest structure, so lines run on into the hole before flat
## areas close over them. Each patch is matched on its known pixels only — no
## guess of the hole takes part — against patches wholly outside the hole,
## searched among those its filled neighbours came from (texture stays
## coherent), random ones, and the best's surroundings; the best is copied in
## as it is. On the CPU, once per fill.
import math
import memory
from raster_errors import invalid, limit

## Patches are (2 × radius + 1) pixels square.
let radius: i64 = 6
## Past this many pixels in the work box the fill refuses.
let work_limit: usize = 6000000
## Random candidates tried for each patch.
let random_tries: usize = 160

## The work box: premultiplied pixels matched on the square roots of light
## (near what the eye sees, so dark texture is told apart as well as bright),
## what is still unknown, how sure each pixel is, where filled pixels came
## from, and which pixels may centre a source patch.
struct Work:
    var width: i64
    var height: i64
    var pixels: f32[]
    var unknown: u8[]
    var confidence: f32[]
    var came_x: i32[]
    var came_y: i32[]
    var source: u8[]
    var sources: i32[]
    var source_count: usize
    ## How often each source centre has been copied from: reused patches cost
    ## more, so one distinctive thing is not stamped over and over.
    var uses: u16[]

    mutating func destroy():
        free(self.pixels) in memory.heap
        free(self.unknown) in memory.heap
        free(self.confidence) in memory.heap
        free(self.came_x) in memory.heap
        free(self.came_y) in memory.heap
        free(self.source) in memory.heap
        free(self.sources) in memory.heap
        free(self.uses) in memory.heap

## Fill `pixels` (premultiplied RGBA, 4 samples a pixel, `width` × `height`)
## where `hole` is non-zero, in place, from the rest; the same `seed` makes
## the same fill. False when there is no hole or nothing outside it to use.
pub func content_fill(pixels: f32[], width: usize, height: usize, hole: const u8[], seed: u64) -> bool!:
    if pixels.length != width * height * 4 or hole.length != width * height:
        error(invalid, "a fill needs RGBA pixels and one hole byte each")
    var left = width
    var top = height
    var right: usize = 0
    var bottom: usize = 0
    for y in 0..<height:
        for x in 0..<width:
            if hole[y * width + x] != 0:
                left = x if x < left else left
                top = y if y < top else top
                right = x + 1 if x + 1 > right else right
                bottom = y + 1 if y + 1 > bottom else bottom
    if right == 0:
        return false
    # The work box: the hole and as much again around it (at most 320 pixels),
    # where the texture to use most likely is.
    let margin = math.max(48.0, math.min(320.0, (f64)math.max((f64)(right - left), (f64)(bottom - top))))
    let box_left = (usize)math.max(0.0, (f64)left - margin)
    let box_top = (usize)math.max(0.0, (f64)top - margin)
    let box_right = (usize)math.min((f64)width, (f64)right + margin)
    let box_bottom = (usize)math.min((f64)height, (f64)bottom + margin)
    if (box_right - box_left) * (box_bottom - box_top) > work_limit:
        error(limit, "the area to fill is too large; select less")
    var work = try work_of(pixels, width, box_left, box_top, box_right - box_left, box_bottom - box_top, hole)
    defer work.destroy()
    if work.source_count == 0:
        return false
    var random = seed | 1
    var queue = try Queue.create()
    defer queue.destroy()
    for y in 0..<work.height:
        for x in 0..<work.width:
            if work.unknown[(usize)(y * work.width + x)] != 0 and on_edge(&work, x, y):
                try queue.push(priority(&work, x, y), y * work.width + x)
    while queue.count > 0:
        let (stored, spot) = queue.pop()
        let x = spot % work.width
        let y = spot // work.width
        # Filled since, off the edge now, or pushed again since with a new priority.
        if work.unknown[(usize)spot] == 0 or not on_edge(&work, x, y) or priority(&work, x, y) != stored:
            continue
        let chosen = best_source(&work, x, y, &random)
        copy_patch(&work, x, y, chosen % work.width, chosen // work.width)
        # Only the edge near the patch changed: its priorities go in afresh.
        for near_y in y - radius - 3..<y + radius + 4:
            for near_x in x - radius - 3..<x + radius + 4:
                if near_x < 0 or near_y < 0 or near_x >= work.width or near_y >= work.height:
                    continue
                if work.unknown[(usize)(near_y * work.width + near_x)] != 0 and on_edge(&work, near_x, near_y):
                    try queue.push(priority(&work, near_x, near_y), near_y * work.width + near_x)
    # The filled box back into the picture.
    for y in 0..<work.height:
        for x in 0..<work.width:
            let index = (usize)(y * work.width + x)
            let global = ((usize)y + box_top) * width + (usize)x + box_left
            if hole[global] == 0:
                continue
            for channel in 0..<(usize)4:
                let value = work.pixels[index * 4 + channel]
                pixels[global * 4 + channel] = value * value
    return true

## The work box of the picture.
func work_of(pixels: const f32[], width: usize, left: usize, top: usize, box_width: usize, box_height: usize, hole: const u8[]) -> Work!:
    let count = box_width * box_height
    let copied = try alloc f32[count * 4] in memory.heap
    errdefer free(copied) in memory.heap
    let unknown = try alloc u8[count] in memory.heap
    errdefer free(unknown) in memory.heap
    let confidence = try alloc f32[count] in memory.heap
    errdefer free(confidence) in memory.heap
    let came_x = try alloc i32[count] in memory.heap
    errdefer free(came_x) in memory.heap
    let came_y = try alloc i32[count] in memory.heap
    errdefer free(came_y) in memory.heap
    for y in 0..<box_height:
        for x in 0..<box_width:
            let origin = (top + y) * width + left + x
            let index = y * box_width + x
            let missing = hole[origin] != 0
            unknown[index] = 1 if missing else 0
            confidence[index] = 0.0 if missing else 1.0
            came_x[index] = -1
            came_y[index] = -1
            for channel in 0..<(usize)4:
                copied[index * 4 + channel] = 0.0 if missing else (f32)math.sqrt(math.max(0.0, (f64)pixels[origin * 4 + channel]))
    let w = (i64)box_width
    let h = (i64)box_height
    let source = try alloc u8[count] in memory.heap
    errdefer free(source) in memory.heap
    # A source patch keeps `gap` pixels clear of the hole too: what the
    # selection cut through (a rock's top, the edge of a figure) is not copied
    # back in.
    let near = try alloc u8[count] in memory.heap
    defer free(near) in memory.heap
    dilate(unknown, near, w, h, gap)
    var found: usize = 0
    for y in 0..<h:
        for x in 0..<w:
            source[(usize)(y * w + x)] = 0
            if x < radius or y < radius or x >= w - radius or y >= h - radius:
                continue
            var clear = true
            var dy = -radius
            while dy <= radius and clear:
                var dx = -radius
                while dx <= radius:
                    if near[(usize)((y + dy) * w + x + dx)] != 0:
                        clear = false
                        break
                    dx += 1
                dy += 1
            if clear:
                source[(usize)(y * w + x)] = 1
                found += 1
    let sources = try alloc i32[found if found > 0 else 1] in memory.heap
    var at: usize = 0
    for index in 0..<count:
        if source[index] != 0:
            sources[at] = (i32)index
            at += 1
    let uses = try alloc u16[count] in memory.heap
    for index in 0..<count:
        uses[index] = 0
    return Work(width = w, height = h, pixels = copied, unknown = unknown, confidence = confidence, came_x = came_x, came_y = came_y,
                source = source, sources = sources, source_count = found, uses = uses)

## An edge pixel's priority for filling around it next: how much of its
## patch is known, times how strong the structure beside it is.
func priority(work: const Work*, x: i64, y: i64) -> f64:
    return patch_confidence(work, x, y) * (0.05 + structure(work, x, y))

## How far from the hole a source patch keeps.
let gap: i64 = 6

## `mask` grown by `reach` pixels every way into `grown` (a square's reach).
func dilate(mask: const u8[], grown: u8[], width: i64, height: i64, reach: i64):
    let across = alloc u8[mask.length] in memory.heap catch _:
        memory.copy(grown, mask, mask.length)
        return
    defer free(across) in memory.heap
    for y in 0..<height:
        for x in 0..<width:
            var hit: u8 = 0
            for dx in -reach..<reach + 1:
                let nx = x + dx
                if nx >= 0 and nx < width and mask[(usize)(y * width + nx)] != 0:
                    hit = 1
                    break
            across[(usize)(y * width + x)] = hit
    for y in 0..<height:
        for x in 0..<width:
            var hit: u8 = 0
            for dy in -reach..<reach + 1:
                let ny = y + dy
                if ny >= 0 and ny < height and across[(usize)(ny * width + x)] != 0:
                    hit = 1
                    break
            grown[(usize)(y * width + x)] = hit

## The edge pixels by priority, highest first: a binary heap. A pixel whose
## priority changes is pushed again; the older entry is passed over when it
## comes up, its priority no longer the pixel's.
struct Queue:
    var priorities: f64[]
    var spots: i64[]
    var count: usize

    static func create() -> Queue!:
        let priorities = try alloc f64[1024] in memory.heap
        errdefer free(priorities) in memory.heap
        let spots = try alloc i64[1024] in memory.heap
        return Queue(priorities = priorities, spots = spots, count = 0)

    mutating func push(value: f64, spot: i64) -> !:
        if self.count == self.priorities.length:
            let priorities = try alloc f64[self.count * 2] in memory.heap
            errdefer free(priorities) in memory.heap
            let spots = try alloc i64[self.count * 2] in memory.heap
            memory.copy(priorities, self.priorities, self.count)
            memory.copy(spots, self.spots, self.count)
            free(self.priorities) in memory.heap
            free(self.spots) in memory.heap
            self.priorities = priorities
            self.spots = spots
        var at = self.count
        self.count += 1
        while at > 0:
            let parent = (at - 1) // 2
            if self.priorities[parent] >= value:
                break
            self.priorities[at] = self.priorities[parent]
            self.spots[at] = self.spots[parent]
            at = parent
        self.priorities[at] = value
        self.spots[at] = spot

    ## The highest, taken out.
    mutating func pop() -> (f64, i64):
        let top = (self.priorities[0], self.spots[0])
        self.count -= 1
        let value = self.priorities[self.count]
        let spot = self.spots[self.count]
        var at: usize = 0
        while true:
            let left = at * 2 + 1
            if left >= self.count:
                break
            var child = left
            if left + 1 < self.count and self.priorities[left + 1] > self.priorities[left]:
                child = left + 1
            if self.priorities[child] <= value:
                break
            self.priorities[at] = self.priorities[child]
            self.spots[at] = self.spots[child]
            at = child
        if self.count > 0:
            self.priorities[at] = value
            self.spots[at] = spot
        return top

    mutating func destroy():
        free(self.priorities) in memory.heap
        free(self.spots) in memory.heap

## Whether unknown pixel (`x`, `y`) touches a known one.
func on_edge(work: const Work*, x: i64, y: i64) -> bool:
    return known_at(work, x + 1, y) or known_at(work, x - 1, y) or known_at(work, x, y + 1) or known_at(work, x, y - 1)

func known_at(work: const Work*, x: i64, y: i64) -> bool:
    return x >= 0 and y >= 0 and x < work.width and y < work.height and work.unknown[(usize)(y * work.width + x)] == 0

## The mean confidence over the patch at (`x`, `y`).
func patch_confidence(work: const Work*, x: i64, y: i64) -> f64:
    var total = 0.0
    var count = 0.0
    for dy in -radius..<radius + 1:
        for dx in -radius..<radius + 1:
            let px = x + dx
            let py = y + dy
            if px >= 0 and py >= 0 and px < work.width and py < work.height:
                total += (f64)work.confidence[(usize)(py * work.width + px)]
                count += 1.0
    return total / count

## How strong the edges among the known pixels next to (`x`, `y`) are: the
## largest difference between known neighbours, so lines are carried in first.
func structure(work: const Work*, x: i64, y: i64) -> f64:
    var strongest = 0.0
    for dy in -2..<(i64)3:
        for dx in -2..<(i64)3:
            let ax = x + dx
            let ay = y + dy
            if not known_at(work, ax, ay):
                continue
            let a = (usize)(ay * work.width + ax)
            if known_at(work, ax + 1, ay):
                strongest = math.max(strongest, luma_gap(work, a, a + 1))
            if known_at(work, ax, ay + 1):
                strongest = math.max(strongest, luma_gap(work, a, (usize)((ay + 1) * work.width + ax)))
    return strongest

func luma_gap(work: const Work*, a: usize, b: usize) -> f64:
    var step = 0.0
    for channel in 0..<(usize)3:
        step += math.abs((f64)(work.pixels[a * 4 + channel] - work.pixels[b * 4 + channel]))
    return step

## The best source patch centre, as an index, for the known pixels of the
## patch at (`x`, `y`): among where its filled neighbours' pixels came from
## (shifted), random sources, and around the best so far.
func best_source(work: const Work*, x: i64, y: i64, random: u64*) -> i64:
    var search = Search(best = -1, cost = 1.0e30)
    # Coherence: what neighbours already filled were copied from, shifted to here.
    for dy in -radius..<radius + 1:
        for dx in -radius..<radius + 1:
            let px = x + dx
            let py = y + dy
            if px < 0 or py < 0 or px >= work.width or py >= work.height:
                continue
            let index = (usize)(py * work.width + px)
            if work.came_x[index] < 0:
                continue
            try_source(work, x, y, (i64)work.came_x[index] - dx, (i64)work.came_y[index] - dy, &search)
    for attempt in 0..<random_tries:
        let pick = (i64)work.sources[(usize)(next(random) % (u64)work.source_count)]
        try_source(work, x, y, pick % work.width, pick // work.width, &search)
    # Refine around the best: ever nearer steps.
    var reach: i64 = 16
    while reach >= 1:
        let cx = search.best % work.width
        let cy = search.best // work.width
        for dy in -1..<(i64)2:
            for dx in -1..<(i64)2:
                try_source(work, x, y, cx + dx * reach, cy + dy * reach, &search)
        reach = reach // 2
    return search.best

## The best source centre so far, as an index, and its cost.
struct Search:
    var best: i64
    var cost: f64

## How much a source's distance counts against it: texture from nearby is
## likelier the same stuff. Height counts thirty times as much as breadth:
## the same height is sky beside sky and sea beside sea, where a photo's
## horizon runs across.
let nearness: f64 = 0.0000002
let height_weight: f64 = 30.0
## What each earlier copy from a source adds to its cost.
let reuse_cost: f64 = 0.0015

## Keep source (`sx`, `sy`) when it is a source and matches better, nearer
## sources winning ties.
func try_source(work: const Work*, x: i64, y: i64, sx: i64, sy: i64, search: Search*):
    if sx < 0 or sy < 0 or sx >= work.width or sy >= work.height or work.source[(usize)(sy * work.width + sx)] == 0:
        return
    let dx = (f64)(sx - x)
    let dy = (f64)(sy - y)
    let far = (dx * dx + dy * dy * height_weight) * nearness + (f64)work.uses[(usize)(sy * work.width + sx)] * reuse_cost
    if far >= search.cost:
        return
    let cost = distance(work, x, y, sx, sy, search.cost - far) + far
    if cost < search.cost:
        search.cost = cost
        search.best = sy * work.width + sx

## The mean squared difference over the known pixels of the patch at (`x`,
## `y`) against the patch at (`sx`, `sy`); given up once past `bound`.
func distance(work: const Work*, x: i64, y: i64, sx: i64, sy: i64, bound: f64) -> f64:
    let most = bound * (f64)((2 * radius + 1) * (2 * radius + 1))
    var total = 0.0
    var known = 0.0
    for dy in -radius..<radius + 1:
        let ty = y + dy
        if ty < 0 or ty >= work.height:
            continue
        for dx in -radius..<radius + 1:
            let tx = x + dx
            if tx < 0 or tx >= work.width:
                continue
            let spot = (usize)(ty * work.width + tx)
            if work.unknown[spot] != 0:
                continue
            let source = (usize)((sy + dy) * work.width + sx + dx) * 4
            for channel in 0..<(usize)4:
                let difference = (f64)(work.pixels[spot * 4 + channel] - work.pixels[source + channel])
                total += difference * difference
            known += 1.0
        if total > most:
            return 1.0e30
    return total / known if known > 0.0 else 1.0e30

## The unknown pixels of the patch at (`x`, `y`) copied from the patch at
## (`sx`, `sy`), now known with the patch's confidence.
func copy_patch(work: Work*, x: i64, y: i64, sx: i64, sy: i64):
    let sure = (f32)patch_confidence(work, x, y)
    let used = (usize)(sy * work.width + sx)
    if work.uses[used] < 65535:
        work.uses[used] += 1
    for dy in -radius..<radius + 1:
        for dx in -radius..<radius + 1:
            let tx = x + dx
            let ty = y + dy
            if tx < 0 or ty < 0 or tx >= work.width or ty >= work.height:
                continue
            let spot = (usize)(ty * work.width + tx)
            if work.unknown[spot] == 0:
                continue
            let taken_x = sx + dx
            let taken_y = sy + dy
            let taken = (usize)(taken_y * work.width + taken_x)
            for channel in 0..<(usize)4:
                work.pixels[spot * 4 + channel] = work.pixels[taken * 4 + channel]
            work.unknown[spot] = 0
            work.confidence[spot] = sure
            work.came_x[spot] = (i32)taken_x
            work.came_y[spot] = (i32)taken_y

## xorshift64*.
func next(state: u64*) -> u64:
    var v = *state
    v ^= v >> 12
    v ^= v << 25
    v ^= v >> 27
    *state = v
    return v *% 2685821657736338717

test "a hole in stripes is filled with stripes":
    let width: usize = 96
    let height: usize = 64
    let pixels = try alloc f32[width * height * 4] in memory.heap
    defer free(pixels) in memory.heap
    let hole = try alloc u8[width * height] in memory.heap
    defer free(hole) in memory.heap
    # Vertical stripes four pixels wide, black and white, opaque.
    for y in 0..<height:
        for x in 0..<width:
            let value: f32 = 1.0 if (x // 4) % 2 == 0 else 0.0
            for channel in 0..<(usize)3:
                pixels[(y * width + x) * 4 + channel] = value
            pixels[(y * width + x) * 4 + 3] = 1.0
            hole[y * width + x] = 1 if x >= 40 and x < 56 and y >= 20 and y < 44 else 0
    assert(try content_fill(pixels, width, height, hole, 7))
    # Inside the hole the stripes carry on: each column stays one tone down its length.
    var matched = 0
    for x in 40..<(usize)56:
        let top = pixels[(20 * width + x) * 4]
        let bottom = pixels[(43 * width + x) * 4]
        if math.abs((f64)(top - bottom)) < 0.2 and (top < 0.2 or top > 0.8):
            matched += 1
    assert(matched >= 12)
    # Alpha is opaque throughout the fill.
    assert(pixels[(30 * width + 48) * 4 + 3] > 0.99)
    # No hole: nothing to do.
    for index in 0..<hole.length:
        hole[index] = 0
    assert(not (try content_fill(pixels, width, height, hole, 7)))
