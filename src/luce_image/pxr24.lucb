## PXR24 predictor reconstruction, based on OpenEXR's BSD-3-Clause algorithm.
## Copyright (c) Contributors to the OpenEXR Project. See LICENSES/OpenEXR.txt.
import memory
import luce_image.deflate as deflate
from luce_image.model import Raster, Chunk

pub func decode(image: const Raster*, chunk: Chunk, data: const u8[], out: u8[]) -> !:
    var stride: usize = 0
    for channel in image.channels:
        stride += 2 if channel.kind == .float16 else 3 if channel.kind == .float32 else 4
    let raw = try alloc u8[chunk.width * chunk.height * stride] in memory.heap
    defer free(raw) in memory.heap
    try deflate.inflate(data, raw)
    var source: usize = 0
    var target: usize = 0
    for y in 0..<chunk.height:
        for channel in image.channels:
            let bytes: usize = 2 if channel.kind == .float16 else 3 if channel.kind == .float32 else 4
            let expanded: usize = 2 if channel.kind == .float16 else 4
            var previous: u32 = 0
            for x in 0..<chunk.width:
                var difference: u32 = 0
                for b in 0..<bytes:
                    difference = (difference << 8) | (u32)raw[source + b * chunk.width + x]
                if channel.kind == .float32:
                    difference <<= 8
                previous +%= difference
                for b in 0..<expanded:
                    out[target] = (u8)(previous >> (b * 8))
                    target += 1
            source += bytes * chunk.width
