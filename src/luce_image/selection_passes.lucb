## The GPU passes that make a selection act on pixels: moving (or copying) the
## selected pixels of a layer, as Photoshop's Move tool does with a selection,
## and keeping an edit — an adjustment, a filter — only where the selection
## covers it. Built once per device, like the other engine passes.
import gpu
import math
from luce_image.tiles import Tiles, tile_size, flatten
from luce_image.document import Document
from luce_image.shaders import lift_frag_words, lift_frag_msl, mask_mix_frag_words, mask_mix_frag_msl
from raster_errors import invalid

pub struct SelectionPasses:
    var owner: gpu.Device
    var lift_shader: gpu.Shader
    var lift: gpu.Pipeline
    var mix_shader: gpu.Shader
    var mix: gpu.Pipeline

    pub static func create(device: gpu.Device) -> SelectionPasses!:
        var lift_shader = try gpu.Shader.create(device, lift_frag_words, lift_frag_msl)
        errdefer lift_shader.destroy()
        var lift = try gpu.Pipeline.create(device, lift_shader, gpu.Blend.replace, gpu.Format.rgba16_float)
        errdefer lift.destroy()
        var mix_shader = try gpu.Shader.create(device, mask_mix_frag_words, mask_mix_frag_msl)
        errdefer mix_shader.destroy()
        var mix = try gpu.Pipeline.create(device, mix_shader, gpu.Blend.replace, gpu.Format.rgba16_float)
        errdefer mix.destroy()
        return SelectionPasses(owner = device, lift_shader = lift_shader, lift = lift, mix_shader = mix_shader, mix = mix)

    ## Move the pixels of `layer` that `selection` covers by (`dx`, `dy`) whole
    ## pixels: they lift out of the layer (or, when `copy`, stay as well) and land
    ## over what is there. `left`, `top`, `right`, `bottom` bound the selection;
    ## tiles neither it nor its moved copy reach are left alone. What leaves the
    ## document is lost.
    pub func move_selected(document: Document*, layer: u64, selection: const Tiles*, dx: i64, dy: i64, copy: bool,
                           left: i64, top: i64, right: i64, bottom: i64) -> !:
        let target = document.find(layer) else error(invalid, "no such layer")
        let tiles = target.tiles() else error(invalid, "a group has no pixels to move")
        if dx == 0 and dy == 0:
            return
        var flat = try flatten(self.owner, tiles)
        defer flat.destroy()
        var mask = try flatten(self.owner, selection)
        defer mask.destroy()
        var params: f32[8] = [0.0, 0.0, (f32)dx, (f32)dy, (f32)tiles.width(), (f32)tiles.height(), 1.0 if copy else 0.0, 0.0]
        for row in 0..<tiles.rows():
            for column in 0..<tiles.columns():
                let x0 = (i64)(column * tile_size)
                let y0 = (i64)(row * tile_size)
                let x1 = x0 + (i64)tile_size
                let y1 = y0 + (i64)tile_size
                let under = x0 < right and x1 > left and y0 < bottom and y1 > top
                let landing = x0 < right + dx and x1 > left + dx and y0 < bottom + dy and y1 > top + dy
                if not (landing or (under and not copy)):
                    continue
                params[0] = (f32)x0
                params[1] = (f32)y0
                var fresh = try tiles.blank()
                errdefer fresh.destroy()
                let frame = try fresh.frame()
                defer frame.release()
                let area = try frame.value().target()
                defer area.release()
                try gpu.shade(area.value(), self.lift, gpu.Rect(width = (f64)tile_size, height = (f64)tile_size), u8[]((u8*)&params[0], 32), [flat, mask], gpu.Filter.nearest)
                discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))
                try tiles.set(column, row, fresh)
        target.revision += 1

    ## Keep the edit just made to `layer` only where `selection` covers it: each
    ## tile becomes `before` and the edited pixels mixed by coverage.
    pub func restrict(document: Document*, layer: u64, before: const Tiles*, selection: const Tiles*) -> !:
        let target = document.find(layer) else error(invalid, "no such layer")
        let tiles = target.tiles() else error(invalid, "a group has no pixels to restrict")
        var blank = try tiles.blank()
        defer blank.destroy()
        var no_uniforms: u8[]
        for row in 0..<tiles.rows():
            for column in 0..<tiles.columns():
                let edited = tiles.texture(column, row)
                let original = before.texture(column, row)
                if edited == none and original == none:
                    continue
                var fresh = try tiles.blank()
                errdefer fresh.destroy()
                let frame = try fresh.frame()
                defer frame.release()
                let area = try frame.value().target()
                defer area.release()
                try gpu.shade(area.value(), self.mix, gpu.Rect(width = (f64)tile_size, height = (f64)tile_size), no_uniforms, [original else blank, edited else blank, selection.texture(column, row) else blank], gpu.Filter.nearest)
                discard(try frame.value().present(gpu.Color(0.0, 0.0, 0.0, 0.0)))
                try tiles.set(column, row, fresh)
        target.revision += 1

    pub mutating func destroy():
        self.mix.destroy()
        self.mix_shader.destroy()
        self.lift.destroy()
        self.lift_shader.destroy()
